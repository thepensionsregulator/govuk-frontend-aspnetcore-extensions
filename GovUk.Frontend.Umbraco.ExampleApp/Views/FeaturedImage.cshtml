@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<FeaturedImage>
@using Microsoft.Extensions.Configuration;
@inject IConfiguration Configuration
@{
    var useTPRstyles = Configuration.GetValue<bool>("TPRStyles");
}
@section head {
	<title>@Model.PageHeadingOrName()</title>
}

@if (useTPRstyles)
{
    <partial name="GOVUK/BlockGrid" model="Model.Blocks" />
}

            