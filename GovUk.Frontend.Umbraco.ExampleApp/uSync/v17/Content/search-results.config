    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
      "key": "e318a2f8-61c8-4c61-845a-f5b09f044654",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Search results"
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "dde55b0f-b511-4956-a211-166d73b921a8",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe search results component can be added to any page where you want the user to be able to search the Q\u0026amp;A content accessible on The Pensions Regulator website. Currently this is focused on Q\u0026amp;As for Automatic Enrolment.\u003C/p\u003E\n\u003Cp\u003EThe following elements can be overridden in content section of the component in Umbraco\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003EHeading\u003C/li\u003E\n\u003Cli\u003EFooter links\u003C/li\u003E\n\u003C/ul\u003E\n\u003Cp\u003EFooter links will always contain a \u003Cstrong\u003E\u0027Show more questions\u0027\u003C/strong\u003E link, that will show the remaining three questions, two are shown when the page loads.\u003C/p\u003E\n\u003Cp\u003EThe following elements can be overridden in settings section of the component in Umbraco\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003EHeading level\u003C/li\u003E\n\u003Cli\u003EHeading class\u003C/li\u003E\n\u003Cli\u003ECSS classes\u003C/li\u003E\n\u003C/ul\u003E\n\u003Cp\u003EThis component should be accompanied with a \u003Cstrong\u003Elink, styled as a button\u003C/strong\u003E component using the CSS class\u0026nbsp;\u003Cstrong\u003Etpr-search-results__nav-button\u003C/strong\u003E. When clicked, it should navigate the user to the search results section on the page.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "94737fb0-c49c-44db-8a59-6a65f14a0c47",
      "key": "8f12d494-7216-43db-8ec7-5abedb7b3c6e",
      "values": [
        {
          "alias": "link",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "name": "",
              "target": "_blank",
              "unique": null,
              "type": null,
              "udi": null,
              "url": "https://www.thepensionsregulator.gov.uk/ae-questions-and-answers",
              "queryString": null
            }
          ]
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Search Q\u0026As"
        }
      ]
    },
    {
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "key": "ba02a710-f699-43ef-ba95-54fe54bf9b3f",
      "values": [
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Example application in Umbraco"
        }
      ]
    },
    {
      "contentTypeKey": "d7921903-6c44-4c50-bef9-7def4b21fae4",
      "key": "3dc05e0a-f441-42b0-9909-b7e51f8f26f2",
      "values": []
    },
    {
      "contentTypeKey": "40bb2a3e-3d75-4ec1-9134-e0c46c6f04a0",
      "key": "7ddd5f85-9941-435a-9cdc-16fe40fc94f4",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003E@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers\u003C/p\u003E\n\u003Cp\u003E\u0026lt;script src=\u0022/ThePensionsRegulator.Frontend/js/tpr-search-results.min.js\u0022 type=\u0022module\u0022 asp-append-version=\u0022true\u0022\u0026gt;\u0026lt;/script\u0026gt;\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "a42a115a-e7b9-4a13-808d-be45c12dea97",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EIf JavaScript is not available then this component will not display and the accompanying button should take the user to the Q\u0026amp;A landing page in a new tab.\u003C/p\u003E\n\u003Cp\u003EUsers have shared that they appreciate not losing their place on the original page and opening links in a new tab offers a similar, seamless experience.\u003C/p\u003E\n\u003Ch2 class=\u0022govuk-heading-m\u0022\u003EConfiguration\u003C/h2\u003E\n\u003Cp\u003EThree URLs are required to be configured to allow this component to show content.\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EPopularContentUrl\u003C/strong\u003E\u003Cbr\u003EThis should return a list of content to show when the page loads. The example app provides an example of the \u003Ca href=\u0022/SearchResultsData/popularContentExample.json\u0022\u003Eexpected structure\u003C/a\u003E.\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003EContentByIdUrl\u003C/strong\u003E\u003Cbr\u003EThis should return a singular result and allow the id of the item to be appended to the URL. The example app provides an example of the \u003Ca href=\u0022/SearchResultsData/example1.json\u0022\u003Eexpected structure\u003C/a\u003E.\u003C/p\u003E\n\u003Cp\u003E\u003Cstrong\u003ESearchContentUrl\u003C/strong\u003E\u003Cbr\u003EThis should return a list of keys that can be retrieved by id. The example app provides an example of the \u003Ca href=\u0022/SearchResultsData/searchResults.json\u0022\u003Eexpected structure\u003C/a\u003E.\u003C/p\u003E\n\u003Cp\u003EThese are configured via the\u00A0\u003Cstrong\u003Eappsettings.json\u003C/strong\u003E under a section named\u00A0 \u003Cstrong\u003ESearchResultsApiEndpoints\u003C/strong\u003E\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "83cb35fb-51da-45cd-913f-1b8bdfd6a1d9",
      "key": "da5a2762-5f53-42fc-8d6b-45ae9c74e14f",
      "values": [
        {
          "alias": "iconFallbackText",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
