@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model TprSessionTimeOutModel
@using ThePensionsRegulator.Frontend.Models

<div id="tpr-session-timeout" class="tpr-session-timeout-warning" role="alertdialog" aria-labelledby="tpr-session-timeout-title" aria-describedby="tpr-session-timeout-description" data-module="govuk-modal">
    <h2 id="tpr-session-timeout-title" class="govuk-heading-m">@Model.Title</h2>
    <div id="tpr-session-timeout-description" class="govuk-body">
        @if (Model.ContentHtml is not null)
        {
            @Model.ContentHtml
        }
        else if (!string.IsNullOrWhiteSpace(Model.Content))
        {
            <p>@Model.Content</p>
        }

        @if (Model.DisplayPrimaryAction && !string.IsNullOrWhiteSpace(Model.PrimaryActionText))
        {
            <a class="govuk-button" href="@Model.PrimaryActionUrl">@Model.PrimaryActionText</a>
        }

        @if (Model.DisplaySecondaryAction && !string.IsNullOrWhiteSpace(Model.SecondaryActionText))
        {
            <div>
                <a class="govuk-link" href="@Model.SecondaryActionUrl">@Model.SecondaryActionText</a>
            </div>
        }
    </div>
</div>
