    },
    {
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "key": "7be56360-2def-4b4a-8a9c-845ba3f08109",
      "udi": null,
      "values": [
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Example application in Umbraco"
        }
      ]
    },
    {
      "contentTypeKey": "6da482da-a53c-4df3-8fd4-697a7d91bbac",
      "key": "e5df46d4-ead2-4379-b9f5-6d91d36a14db",
      "udi": null,
      "values": [
        {
          "alias": "hint",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe validation will fail if no file is provided. The choose file dialog will only allow selection of a CSV file based on its file extension, but any file can be uploaded using drag and drop.\u003C/p\u003E"
          }
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Upload a CSV spreadsheet"
        }
      ]
    },
    {
      "contentTypeKey": "35584ae7-feb5-4de8-9008-5d2d8cfb34ce",
      "key": "f0ae6c5a-5473-4edc-a757-e89e1e28a056",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Submit"
        }
      ]
    },
    {
      "contentTypeKey": "6da482da-a53c-4df3-8fd4-697a7d91bbac",
      "key": "ddb17629-a8f5-4216-a321-bf8cd31dbd3c",
      "udi": null,
      "values": [
        {
          "alias": "hint",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EYou should only ask users to upload something if it\u2019s critical to the delivery of your service.\u003C/p\u003E\n\u003Cp\u003EThis file upload has its label set as the page heading.\u003C/p\u003E\n\u003Cp\u003EThe choose file dialog will only allow selection of an image based on its media types, but any file can be uploaded using drag and drop.\u003C/p\u003E"
          }
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "{{name}}"
        }
      ]
    },
    {
      "contentTypeKey": "6da482da-a53c-4df3-8fd4-697a7d91bbac",
      "key": "789d8ea2-fc18-4bb9-b99e-1e161b11de68",
      "udi": null,
      "values": [
        {
          "alias": "hint",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe validation should fail if the file is not an Excel file. The validation will look at the binary file header to determine whether the file is an Excel file.\u003C/p\u003E"
          }
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Upload an Excel file"
        }
      ]
    },
    {
      "contentTypeKey": "6da482da-a53c-4df3-8fd4-697a7d91bbac",
      "key": "8dc53753-5088-4c30-861b-ba4b8d35ab56",
      "udi": null,
      "values": [
        {
          "alias": "hint",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe validation should fail if the file is not a PDF file. The validation will look at the binary file header to determine whether the file is a PDF file.\u003C/p\u003E"
          }
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Upload a PDF file"
        }
      ]
    },
    {
      "contentTypeKey": "6da482da-a53c-4df3-8fd4-697a7d91bbac",
      "key": "179e8200-f898-43a0-8090-cae7b1e1a2f5",
      "udi": null,
      "values": [
