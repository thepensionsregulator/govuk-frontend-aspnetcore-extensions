    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "f6a573bd-f724-4a3a-a27d-495fa83bebbe",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EBy default components added directly inside a \u0027Grid row\u0027 will not render extra grid markup, so setting something like \u0027CSS classes for row\u0027 on one of those components will not work.\u003C/p\u003E\n\u003Cp\u003EIf you need to use these properties add a \u0027Grid column\u0027 inside the \u0027Grid row\u0027 and move your \u0027Error message\u0027 and fields inside the \u0027Grid column\u0027. Switch on \u0027Render rows and columns for child blocks\u0027 on the settings of the \u0027Grid column\u0027.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
