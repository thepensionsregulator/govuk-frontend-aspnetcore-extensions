            }
          },
          {
            "contentTypeKey": "e8386da2-bf9c-43e2-ac0e-02f33f6b6c2d",
            "udi": "umb://element/dc9ef7dbe06546ca8783e45fc8c119a5",
            "blocks": {
              "layout": {
                "Umbraco.BlockList": [
                  {
                    "contentUdi": "umb://element/4d96447299d246bdbdf66bd3f5b44508",
                    "settingsUdi": "umb://element/eedd5574409c4f388f7c865d62820f6d"
                  }
