  <Properties>
    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "key": "699582df-404d-4333-9bed-8d0d33465201",
      "udi": null,
      "values": [
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Example application in Umbraco"
        }
      ]
    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
      "key": "37f1bff6-caba-474a-961d-f9272623878b",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "2f79733d-29d9-4344-b69e-1c4dc3d9f155",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EError messages are normally configured as part of components like \u003Ca href=\u0022/{localLink:acbabf45-7b3e-4b53-a825-f7b6185f8840}\u0022 type=\u0022document\u0022\u003Etext input\u003C/a\u003E.\u00A0\u003C/p\u003E\n\u003Cp\u003EThis component can be used if you have a different scenario, such as an error that spans multiple fields. If you bind it to a property on the view model, it will be visible only when that property is invalid in ModelState.\u003C/p\u003E\n\u003Cp\u003EIf you add an \u0027Error message\u0027 bound to a property directly inside a \u0027Fieldset\u0027 block, when the property is invalid the whole fieldset will be invalid. You can disable this behaviour in the settings of the \u0027Fieldset\u0027 block if you need to.\u003C/p\u003E\n\u003Cp\u003EFor completely custom behaviour don\u0027t bind it to a property, but instead control when it appears using custom code - see \u003Ca href=\u0022/{localLink:dd8e62c7-3e92-4bf2-8803-ec2d080626e8}\u0022 type=\u0022document\u0022\u003Efilter and override blocks\u003C/a\u003E.\u003C/p\u003E\n\u003Cp\u003EWhen the fieldset is in an error state the error border should extend down the side of every field.\u00A0There is introductory text between the page heading and the fields (this text) and, though this is inside the fieldset, it must not be included in the scope of the fieldset error border.\u003C/p\u003E\n\u003Cp\u003EThe following example demonstrates fieldset-level validation. This example will always be invalid.\u003C/p\u003E"
          }
        }
      ]
    },
