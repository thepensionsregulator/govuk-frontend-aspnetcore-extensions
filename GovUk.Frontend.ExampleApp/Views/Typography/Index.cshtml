@{
    ViewData["Title"] = "Typography";
}

<span class="govuk-caption-xl">Example application</span>
<div class="govuk-grid-row govuk-grid-row--tpr-divider">
    <div class="govuk-grid-column govuk-grid-column-full">
        <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column govuk-grid-column-two-thirds-from-desktop">
        <p class="govuk-body">This text and this application is using <a class="govuk-link" href="https://design-system.service.gov.uk/styles/typography/">GOV.UK Design System typography</a>.</p>
        <p class="govuk-body">Typical pages start heading sizes at using <i>govuk-heading-l</i>. Where pages are expected to have deeply nested section hierarchies, we use <a class="govuk-link" href="/largerheadings">larger headings</a>.</p>
        <p class="govuk-body">The heading above demonstrates the type scale at Heading 1, using <i>govuk-heading-l</i>.</p>
        <h2 class="govuk-heading-m">Heading 2</h2>
        <p class="govuk-body">On a typical page this is the type scale for headings.</p>
        <h3 class="govuk-heading-s">Heading 3</h3>
        <p class="govuk-body">On a typical page this is the type scale for headings. We would not expect to need headings beyond Heading 3.</p>
    </div>
</div>
