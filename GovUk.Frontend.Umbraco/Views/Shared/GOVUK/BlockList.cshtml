@using GovUk.Frontend.Umbraco.Blocks
@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IEnumerable<BlockListItem>>
@inject BlockViewService blockViewService
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var blocks = blockViewService.PrepareBlockViewModels(Model, ViewContext.ModelState);
    if (!blocks.Any()) { return; }

    foreach (var block in blocks)
    {
        <partial name="GOVUK/BlockListBlock" model="block" />
    }
}