@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<SectionCards>
@using Microsoft.Extensions.Configuration;
@using GovUk.Frontend.ExampleSharedResource;
@inject Microsoft.Extensions.Options.IOptions<AppConfig> Configuration;
@{
    var useTPRstyles = Configuration.Value.TPRStyles;
}
@section head {
	<title>@Model.PageHeadingOrName()</title>
}

@if (useTPRstyles)
{
    <partial name="GOVUK/BlockGrid" model="Model.GridBlocks" />
}
else
{
    <partial name="GOVUK/BlockList" model="Model.GovukBlocks" />
}