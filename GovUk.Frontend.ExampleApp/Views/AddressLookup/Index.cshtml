@using ThePensionsRegulator.Frontend.HtmlGeneration
@{
    ViewData["Title"] = "Address lookup";

    var content = new TprAddressLookupContent
    {
        AddressLookupIntroductionHeading = "Find your address from example app view",
        AddressLookupIntroductionText = "Enter your postcode to find your address from example app view.",
        SearchLegend = "Search legend from the view"
    };
}

@model AddressLookupViewModel

<span class="govuk-caption-xl">Example application</span>
<div class="govuk-grid-row govuk-grid-row--tpr-divider">
    <div class="govuk-grid-column govuk-grid-column-full">
        <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
    </div>
</div>

<form method="post">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column govuk-grid-column-full">
            <tpr-address-lookup 
                address-search-url="/AddressLookupData/Address.json"
                for="@nameof(Model.ShippingAddress)" 
                content="@content"
                govuk-heading-class="govuk-heading-m" />
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column govuk-grid-column-full">
            <button type="submit" class="govuk-button">Submit</button>
        </div>
    </div>
</form>

@section scripts {
    <script src="~/js/address-lookup-example.js" type="module"></script>
}