            }
        </govuk-input>
    </govuk-client-side-validation>

    <govuk-client-side-validation error-message-required="This field is required"
                                  error-message-maxlength="Cannot exceed the maximum length">
        <govuk-input for="BillingPostcode" input-class="govuk-input--width-10" autocomplete="postal-code"
                     input-attributes="@(new Dictionary<string, string?>{{"data-address-lookup", "postcode"}})">
            <govuk-input-label>Postcode</govuk-input-label>
            @if (ViewContext.ModelState.ContainsKey("BillingPostcode") && ViewContext.ModelState["BillingPostcode"]!.Errors.Count > 0)
            {
                <govuk-input-error-message>@ViewContext.ModelState["BillingPostcode"]!.Errors[0].ErrorMessage</govuk-input-error-message>
            }
        </govuk-input>
    </govuk-client-side-validation>

    <input type="hidden" id="BillingUPRN" name="BillingUPRN" value="@Model?.BillingUPRN" data-address-lookup="UPRN" />
</tpr-address-lookup>

<govuk-button type="submit">Save</govuk-button>