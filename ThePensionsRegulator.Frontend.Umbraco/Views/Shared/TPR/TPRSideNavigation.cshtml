@using GovUk.Frontend.Umbraco
@using ThePensionsRegulator.Frontend.Umbraco
@using ThePensionsRegulator.Umbraco
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Routing
@using Umbraco.Extensions

@inject IPublishedUrlProvider publishedUrlProvider
@inject IUmbracoPublishedContentAccessor publishedContext
@{
    var currentPage = publishedContext.PublishedContent;
    var rootAncestorLink = Model.Content.Value<Link>(TprPropertyAliases.SideNavigationRoot);
    var rootAncestorChildren = rootAncestorLink.Content.Children;
    var cssClasses = Model.Settings.Value<string>(PropertyAliases.CssClasses);

    var blacklistedPages = Model.Content.Value<IEnumerable<Link>>(TprPropertyAliases.SideNavigationBlacklistedPages);
    List<string> blacklistedNames = new();
    List<string> blacklistedUrls = new();
    foreach (var pageLink in blacklistedPages)
    {
        blacklistedNames.Add(pageLink.Name);
        blacklistedUrls.Add(pageLink.Url);
    }
}

<nav class="@cssClasses">
    <h2>
        <a class="govuk-link" href="@rootAncestorLink.Url">@rootAncestorLink.Name</a>
    </h2>
    <ul>
        @foreach (IPublishedContent level1Child in rootAncestorChildren)
        {
            @if (blacklistedNames.Contains(level1Child.Name) || blacklistedUrls.Contains(level1Child.Url(publishedUrlProvider))) { continue; }

            @if (level1Child == currentPage || currentPage.Ancestors().Contains(level1Child))
            {
                <li>
                    <a class="govuk-link" href="@level1Child.Url(publishedUrlProvider)">@level1Child.Name</a>
                    @if (level1Child.Children().Any())
                    {
                        <ul>
                            @foreach (IPublishedContent level2Child in level1Child.Children())
                            {
                                @if (blacklistedNames.Contains(level2Child.Name) || blacklistedUrls.Contains(level2Child.Url(publishedUrlProvider))) { continue; }

                                @if (level2Child == currentPage || currentPage.Ancestors().Contains(level2Child))
                                {
                                    <li>
                                        <a class="govuk-link" href="@level2Child.Url(publishedUrlProvider)">@level2Child.Name</a>
                                        @if (level2Child.Children().Any())
                                        {
                                            <ul>
                                                @foreach (IPublishedContent level3Child in level2Child.Children())
                                                {
                                                    @if (blacklistedNames.Contains(level3Child.Name) || blacklistedUrls.Contains(level3Child.Url(publishedUrlProvider))) { continue; }

                                                    <li>
                                                        <a class="govuk-link" href="@level3Child.Url(publishedUrlProvider)">@level3Child.Name</a>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="govuk-link" href="@level2Child.Url(publishedUrlProvider)">@level2Child.Name</a>
                                    </li>
                                }
                            }
                        </ul>
                    }
                </li>
            }
            else
            {
                <li>
                    <a class="govuk-link" href="@level1Child.Url(publishedUrlProvider)">@level1Child.Name</a>
                </li>
            }
        }
    </ul>
</nav>