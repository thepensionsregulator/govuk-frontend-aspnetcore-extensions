@{
    ViewData["Title"] = "Larger headings";
}

<span class="govuk-caption-xl">Example application</span>
<div class="govuk-grid-row govuk-grid-row--tpr-divider">
    <div class="govuk-grid-column govuk-grid-column-full">
        <h1 class="govuk-heading-xl">@ViewData["Title"]</h1>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column govuk-grid-column-two-thirds-from-desktop">
        <p class="govuk-body">This text and this application is using <a class="govuk-link" href="https://design-system.service.gov.uk/styles/typography/">GOV.UK Design System typography</a>.</p>
        <p class="govuk-body">Typical pages use standard <a class="govuk-link" href="/typography">typography</a>. Where pages are expected to have deeply nested section hierarchies, we start heading sizes at <i>govuk-heading-xl</i>.</p>
        <p class="govuk-body">The heading above demonstrates the type scale at Heading 1, using <i>govuk-heading-xl</i>.</p>
        <h2 class="govuk-heading-l">Heading 2</h2>
        <p class="govuk-body">On a page with deeply nested sections this is the type scale for headings.</p>
        <h3 class="govuk-heading-m">Heading 3</h3>
        <p class="govuk-body">On a page with deeply nested sections this is the type scale for headings.</p>
        <h4 class="govuk-heading-s">Heading 4</h4>
        <p class="govuk-body">On a page with deeply nested sections this is the type scale for headings.</p>
        <h5 class="govuk-heading-s">Heading 5</h5>
        <p class="govuk-body">On a page with deeply nested sections this is the type scale for headings.</p>
        <h6 class="govuk-heading-s">Heading 6</h6>
        <p class="govuk-body">On a page with deeply nested sections this is the type scale for headings.</p>
    </div>
</div>

