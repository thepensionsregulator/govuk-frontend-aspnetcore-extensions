  },
  "contentData": [
    {
      "caption": "Example application in Umbraco",
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "udi": "umb://element/dc035316614d4ae68aea2da054cf5234"
    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
      "text": "",
      "udi": "umb://element/d2e16cbc930241b3a7bcc5ec6f9b4867"
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "text": {
        "markup": "<p class=\"govuk-heading-m govuk-body\">You can filter and override block list and block grid items from code in the controller for the document type. See <a href=\"https://our.umbraco.com/documentation/reference/routing/custom-controllers\">Umbraco custom controllers</a> and the code for <em>FilterAndOverrideBlocksController.cs</em> in this project.</p>\n<h2 class=\"govuk-heading-m\">Filter block list items</h2>\n<p>This is the first item. The second one should be removed by a filter which is defined in the controller.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/e60b4f17fe5049aea43951c9255d6410"
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "text": {
        "markup": "<p>This is the second item. It should be removed by a filter which is defined in the controller.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/c12234d2e0344bb7a4c32c5ddf2a7295"
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "text": {
        "markup": "<h2 class=\"govuk-heading-m\">Override block list items</h2>\n<p>The properties of block list items can be overridden from the controller. The next paragraph says \"This is the original text.\" in the back office, but should be displayed as \"This text is overridden.\"</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/af8c642b39ab4e82ae82f9af7b7ae1cf"
    },
    {
      "blocks": {
        "layout": {
          "Umbraco.BlockList": [
            {
              "contentUdi": "umb://element/906435b3d6424f0f943ad02d1993d8ea",
              "settingsUdi": "umb://element/82261fb0ab7d466ab5d6cd204ce29594"
            },
            {
              "contentUdi": "umb://element/cf04223a2c674418910be188adb5098b",
              "settingsUdi": "umb://element/8d666d23698140e39cc882fe117902fc"
            }
          ]
        },
        "contentData": [
          {
            "blocks": {
              "layout": {
                "Umbraco.BlockList": [
                  {
                    "contentUdi": "umb://element/9c7994baa2b24d34a6332a94df569083",
                    "settingsUdi": "umb://element/1b31d9cd1ba34be7be5a2dde80de54c5"
                  }
                ]
              },
              "contentData": [
                {
                  "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
                  "text": {
                    "markup": "<p>Overriding blocks should also work within nested grid rows and columns. The paragraph in the next column says \"This is the original text.\" in the back office, but should be displayed as \"This text is overridden.\"</p>",
                    "blocks": {
                      "contentData": [],
                      "settingsData": []
                    }
                  },
                  "udi": "umb://element/9c7994baa2b24d34a6332a94df569083"
                }
              ],
              "settingsData": [
                {
                  "columnSize": "",
                  "columnSizeFromDesktop": "",
                  "contentTypeKey": "21721e40-fe18-447b-bbd6-00c02bd5539b",
                  "udi": "umb://element/1b31d9cd1ba34be7be5a2dde80de54c5"
                }
              ]
            },
            "contentTypeKey": "e8386da2-bf9c-43e2-ac0e-02f33f6b6c2d",
            "udi": "umb://element/906435b3d6424f0f943ad02d1993d8ea"
          },
          {
            "blocks": {
              "layout": {
