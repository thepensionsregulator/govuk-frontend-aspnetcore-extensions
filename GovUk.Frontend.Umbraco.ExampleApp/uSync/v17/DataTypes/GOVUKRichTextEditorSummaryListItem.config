<?xml version="1.0" encoding="utf-8"?>
<DataType Key="0729c57a-748f-482d-abbc-fcd2976c9fc6"
  Alias="GOV.UK Rich text editor (Summary list item)" Level="2">
  <Info>
    <Name>GOV.UK Rich text editor (Summary list item)</Name>
    <EditorAlias>Umbraco.RichText</EditorAlias>
    <EditorUIAlias>Umb.PropertyEditorUi.Tiptap</EditorUIAlias>
    <Folder>GOV.UK</Folder>
  </Info>
  <Config><![CDATA[{
  "extensions": [
    "Umb.Tiptap.RichTextEssentials",
    "Umb.Tiptap.Blockquote",
    "Umb.Tiptap.Bold",
    "Umb.Tiptap.BulletList",
    "Umb.Tiptap.CodeBlock",
    "Umb.Tiptap.Heading",
    "Umb.Tiptap.Italic",
    "Umb.Tiptap.Link",
    "Umb.Tiptap.OrderedList",
    "Umb.Tiptap.Subscript",
    "Umb.Tiptap.Superscript"
  ],
  "ignoreUserStartNodes": false,
  "maxImageSize": 500,
  "overlaySize": "small",
  "stylesheets": [
    "/site.css",
    "/govuk-umbraco-backoffice.css"
  ],
  "toolbar": [
    [
      [
        "Umb.Tiptap.Toolbar.ClearFormatting"
      ],
      [
        "GovUk.Frontend.Umbraco.Styles",
        "Umb.Tiptap.Toolbar.Bold",
        "Umb.Tiptap.Toolbar.Italic",
        "Umb.Tiptap.Toolbar.Link",
        "GovUk.Frontend.Umbraco.Styles",
        "Umb.Tiptap.Toolbar.Unlink"
      ],
      [
        "Umb.Tiptap.Toolbar.BulletList",
        "Umb.Tiptap.Toolbar.OrderedList"
      ],
      [
        "Umb.Tiptap.Toolbar.Superscript",
        "Umb.Tiptap.Toolbar.Subscript",
        "Umb.Tiptap.Toolbar.CharacterMap",
        "Umb.Tiptap.Toolbar.CharacterMap"
      ]
    ]
  ]
}]]></Config>
</DataType>