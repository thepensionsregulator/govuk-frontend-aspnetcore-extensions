@using GovUk.Frontend.AspNetCore.Extensions.Security
@using Microsoft.CSharp.RuntimeBinder
@using ThePensionsRegulator.Frontend.Security
@inject IConsentCookieReader consentCookie
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    // If AblePlayer is enabled it will set cookies, so check for consent first.
    if (!consentCookie.HasConsent(TprConsentCookieReader.TPR_CONSENT_CATEGORY_FUNCTIONALITY)){ return; }
}
<script src="/ThePensionsRegulator.GovUk.Frontend/lib/jquery/dist/jquery.min.js" type="module" asp-append-version="true"></script>
<script src="/ThePensionsRegulator.Frontend/lib/js.cookie.min.js" type="module" asp-append-version="true"></script>
<link rel="stylesheet" href="/ThePensionsRegulator.Frontend/lib/ableplayer/build/ableplayer.min.css" type="module" asp-append-version="true" />
<script src="/ThePensionsRegulator.Frontend/lib/ableplayer/build/ableplayer.min.js" type="module" asp-append-version="true"></script>