@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Web.Common
@using GovUk.Frontend.Umbraco
@using ThePensionsRegulator.Frontend.Umbraco
@inject UmbracoHelper Umbraco
@addTagHelper *, ThePensionsRegulator.Frontend

@{
    var outerCssClasses = Model.Settings.Value<string>(PropertyAliases.CssClasses);
    var documents = Model.Content.Value<IEnumerable<BlockListItem>>(TprPropertyAliases.DocumentsBlockList);
}

<tpr-documents outercss="@outerCssClasses">

    @foreach (var document in documents)
    {
        var documentLink = document.Content.Value<Link>(TprPropertyAliases.Document);
        if (documentLink != null)
        {
            var innerCssClasses = document.Settings.Value<string>(PropertyAliases.CssClasses);
            var docHref = documentLink.Url;
            var docLinkType = documentLink.Type;
            var docPages = document.Content.Value<string>(TprPropertyAliases.DocumentNumberOfPages);
            var dteValue = document.Content.Value<DateTime>(TprPropertyAliases.DocumentDatePublished);
            var docDatePublished = dteValue > DateTime.MinValue ? dteValue.ToString("MMMM yyyy") : null;
            var docDescription = document.Content.Value<string>(TprPropertyAliases.DocumentDescription);

            if (docLinkType == LinkType.Media)
            {
                // TODO: Get size from media cache
                var docKB = 0; // documentLink.Content.UmbracoBytes / 1024; 
                var docTitle = "";

                // TODO: Get media library item name from media cache
                var mediaLinkDocName = "Media library item"; // documentLink.Content.Name;
                var mediaLinkTitle = documentLink.Name;
                // TODO: Get media type alias from media cache
                var mediaType = "File"; //documentLink.Content?.ContentType?.Alias;

                if (!string.Equals(mediaLinkDocName, mediaLinkTitle, StringComparison.OrdinalIgnoreCase))
                {
                    docTitle = mediaLinkTitle;
                }
                else
                {
                    // TODO: Get DocumentTitle from media cache
                    docTitle = mediaLinkDocName;
                    @* docTitle = (mediaType == "File" && !string.IsNullOrEmpty(documentLink.Content?.DocumentTitle))
                        ? documentLink.Content.DocumentTitle
                        : mediaLinkDocName; *@
                }

                <tpr-document href="@docHref" kbsize="@docKB" pages="@docPages" datepublished="@docDatePublished" innercss="@innerCssClasses">

                    <tpr-document-title>@docTitle</tpr-document-title>

                    <tpr-document-description>@docDescription</tpr-document-description>

                </tpr-document>
            }
            else
            {
                <tpr-document href="@docHref" pages="@docPages" datepublished="@docDatePublished" innercss="@innerCssClasses">

                    <tpr-document-title>@documentLink.Name</tpr-document-title>

                    <tpr-document-description>@docDescription</tpr-document-description>

                </tpr-document>
            }
        }
    }

</tpr-documents>