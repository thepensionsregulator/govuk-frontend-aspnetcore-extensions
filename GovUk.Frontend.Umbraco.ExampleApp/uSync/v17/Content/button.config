    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "9476ebde-6c11-4904-bfd6-9eadcea3456c",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe following button styles are supported when using The Pensions Regulator branding. It is possible to configure other combinations in Umbraco, but they are not yet supported.\u003C/p\u003E\n\u003Cp\u003EYou can bind a button to a string property on your view model. On a page with multiple buttons this will let you detect which button was clicked.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "1b691836-7281-4b87-ae17-99ef1b888ec4",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003ELinks, styled as a button can be set to open in a new tab. Enabiling this setting will also add a visually hidden span with the text \u0022(opens in a new tab)\u0022, which can be customised with the dictionary key of \u0022(opens in a new tab)\u0022.\u003C/p\u003E"
          }
        }
      ]
    },
