{
  "name": "govuk-frontend-aspnetcore-extensions",
  "version": "1.0.0",
  "description": "Adds client-side validation and editing in Umbraco to https://github.com/gunndabad/govuk-frontend-aspnetcore",
  "main": "index.js",
  "repository": "https://github.com/thepensionsregulator/govuk-frontend-aspnetcore-extensions.git",
  "author": "The Pensions Regulator <no-reply@tpr.gov.uk>",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^14.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "rootDir": "GovUk.Frontend.AspNetCore.Extensions",
    "collectCoverage": true,
    "collectCoverageFrom": ["wwwroot/govuk/**/*.js"]
  },
  "resolutions": {
    "json5": "2.2.2"
  },
  "overrides": {
    "jest-environment-jsdom":{
      "jsdom": "26.1.0"
    }
  },
  "dependencies": {
    "govuk-frontend": "5.8.0"
  }
}
