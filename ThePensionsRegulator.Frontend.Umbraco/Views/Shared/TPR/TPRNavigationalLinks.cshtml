@using ThePensionsRegulator.Frontend.Umbraco
@using ThePensionsRegulator.GovUk.Frontend.Umbraco
@{
    var cssClasses = Model.Settings.Value<string>(PropertyAliases.CssClasses);
    var text = Model.Content.Value<string>(TprPropertyAliases.NavigationalLinksText);
    var label = string.IsNullOrWhiteSpace(Model.Content.Value<string>(TprPropertyAliases.NavigationalLinksLabel)) ? "List of in-page anchor links" : Model.Content.Value<string>(TprPropertyAliases.NavigationalLinksLabel);
}

<nav @(string.IsNullOrWhiteSpace(cssClasses) ? string.Empty : "class=" + cssClasses) aria-label="@label">
    @Html.Raw(text)
</nav>