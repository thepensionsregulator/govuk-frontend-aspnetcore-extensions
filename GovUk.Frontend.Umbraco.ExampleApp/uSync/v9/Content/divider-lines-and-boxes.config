    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "udi": "umb://element/d8450d8cadcc4b60a0c96daf1837814e",
      "text": {
        "markup": "<p>A box can be full-width, if&nbsp;<em>RenderWidthContainerForBlocks</em> is enabled for the application.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      }
    },
