    <govuk-client-side-validation error-message-required="This field is required">
        <govuk-input for="BillingCountry" input-class="govuk-input--width-20" autocomplete="country"
                     input-attributes="@(new Dictionary<string, string?>{{"data-address-lookup", "country"}})">
            <govuk-input-label>Country</govuk-input-label>
            @if (ViewContext.ModelState.ContainsKey("BillingCountry") && ViewContext.ModelState["BillingCountry"]!.Errors.Count > 0)
            {
