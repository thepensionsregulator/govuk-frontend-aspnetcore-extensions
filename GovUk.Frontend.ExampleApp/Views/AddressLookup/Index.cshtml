@using ThePensionsRegulator.Frontend.HtmlGeneration
@using ThePensionsRegulator.Frontend.Models
@{
    ViewData["Title"] = "Address lookup";

    var billingContent = new TprAddressLookupContent
    {
        AddressLookupIntroductionHeading = "Billing address",
        AddressLookupIntroductionText = "Enter the address to use for billing.",
        SearchLegend = "Find your billing address",
        SameAsLabel = "Same as shipping address"
    };
}

@model AddressLookupViewModel

<span class="govuk-caption-xl">Example application</span>
<div class="govuk-grid-row govuk-grid-row--tpr-divider">
    <div class="govuk-grid-column govuk-grid-column-full">
        <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
    </div>
</div>

<form method="post">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column govuk-grid-column-full">
            <tpr-address-lookup address-search-url="/AddressLookupData/Address.json"
                                for="@nameof(Model.ShippingAddress)" role="@TprAddressLookupRole.Primary"
                                govuk-heading-class="govuk-heading-m" />
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column govuk-grid-column-full">
            <tpr-address-lookup address-search-url="/AddressLookupData/Address.json" for="@nameof(Model.BillingAddress)"
                                role="@TprAddressLookupRole.Secondary" content="@billingContent"
                                govuk-heading-class="govuk-heading-m" />
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column govuk-grid-column-full">
            <button type="submit" class="govuk-button">Submit</button>
        </div>
    </div>
</form>

@section scripts {
    <script src="~/js/address-lookup-example.js" type="module"></script>
}