{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "dotnet",
			"task": "build",
			"group": "build",
			"problemMatcher": [],
			"label": "dotnet: build"
		},
		{
			"label": "build: ExampleApp",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/GovUk.Frontend.ExampleApp/GovUk.Frontend.ExampleApp.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "watch: ExampleApp",
			"type": "process",
			"command": "dotnet",
			"args": [
				"watch",
				"run",
				"--project",
				"${workspaceFolder}/GovUk.Frontend.ExampleApp/GovUk.Frontend.ExampleApp.csproj"
			],
			"isBackground": true,
			"problemMatcher": "$msCompile",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			}
		}
	]
}