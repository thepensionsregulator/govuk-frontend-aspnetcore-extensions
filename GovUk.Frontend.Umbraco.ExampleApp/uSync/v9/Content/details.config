    },
    {
      "contentTypeKey": "9d15adb9-fb63-4b20-ada3-fc9239a72a8c",
      "summary": "Custom classes are supported when there's only one paragraph",
      "text": {
        "markup": "<p class=\"custom-class\">When there is a single paragraph with no class applied, the surrounding <strong>p </strong>element should be removed. This details component is a single paragraph but a custom class is applied, so the&nbsp;<strong>p</strong> element should be kept.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/62898fa9189546a4b1e79f075d06a7a7"
    },
    {
      "contentTypeKey": "9d15adb9-fb63-4b20-ada3-fc9239a72a8c",
      "summary": "Complex rich text is supported",
      "text": {
        "markup": "<p>Details components can contain many paragraphs of detailed information.</p>\n<p class=\"custom-class\">Custom classes can be applied when there are multiple paragraphs.</p>\n<p style=\"text-align: center;\">Text can be centred.</p>\n<p style=\"text-align: right;\">Text can be right aligned.</p>\n<ul>\n<li style=\"text-align: left;\">Unordered lists are allowed</li>\n<li style=\"text-align: left;\">Unordered lists are allowed</li>\n</ul>\n<ol>\n<li style=\"text-align: left;\">Ordered lists are allowed</li>\n<li style=\"text-align: left;\">Ordered lists are allowed</li>\n</ol>\n<h2 class=\"govuk-heading-m\" style=\"text-align: left;\">Tables and subheadings are allowed</h2>\n<table>\n<thead>\n<tr>\n<th>Header 1</th>\n<th>Header 2</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Data 1</td>\n<td>Data 2</td>\n</tr>\n</tbody>\n</table>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/de0b39d1f30d4d83ad1c8007a4e63b51"
    }
  ],
