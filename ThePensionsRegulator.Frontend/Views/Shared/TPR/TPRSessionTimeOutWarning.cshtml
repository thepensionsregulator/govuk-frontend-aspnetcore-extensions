@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model TprSessionTimeOutModel
@using ThePensionsRegulator.Frontend.Models
@using System.Globalization

<dialog id="tpr-session-timeout" class="tpr-session-timeout-warning" role="alertdialog" aria-labelledby="tpr-session-timeout-title" aria-describedby="tpr-session-timeout-description"
        data-module="@(Model.Settings is null ? null : "tpr-session-timeout")"
        data-timeout-ms="@Model.Settings?.RemainingTime.TotalMilliseconds.ToString(CultureInfo.InvariantCulture)"
        data-extension-ms="@Model.Settings?.ExtensionLength.TotalMilliseconds.ToString(CultureInfo.InvariantCulture)"
        data-warning-ms="@Model.Settings?.WarningBeforeExpiry.TotalMilliseconds.ToString(CultureInfo.InvariantCulture)"
        data-session-timeout-expiry-url="@Model.Settings?.ExpiryUrl">
    <h2 id="tpr-session-timeout-title" class="govuk-heading-m">@Model.Title</h2>
    <div id="tpr-session-timeout-description" class="govuk-body" data-session-timeout-content>
        @if (Model.ContentHtml is not null)
        {
            @Model.ContentHtml
        }
        else if (!string.IsNullOrWhiteSpace(Model.Content))
        {
            <p>@Model.Content</p>
        }
    </div>
        @if (Model.DisplayPrimaryAction && !string.IsNullOrWhiteSpace(Model.PrimaryActionText))
        {
        <button class="govuk-button" type="button" data-session-timeout-extend data-session-timeout-extend-url="@Model.PrimaryActionUrl">@Model.PrimaryActionText</button>
        }

        @if (Model.DisplaySecondaryAction && !string.IsNullOrWhiteSpace(Model.SecondaryActionText) && !string.IsNullOrWhiteSpace(Model.SecondaryActionUrl))
        {
            <div>
                <a class="govuk-link" href="@Model.SecondaryActionUrl">@Model.SecondaryActionText</a>
            </div>
        }
</dialog>


