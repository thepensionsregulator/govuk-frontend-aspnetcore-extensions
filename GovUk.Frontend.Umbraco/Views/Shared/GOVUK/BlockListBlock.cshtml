@using GovUk.Frontend.Umbraco.Blocks
@using GovUk.Frontend.Umbraco.Services;
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@model BlockViewModel
@inject IEnumerable<IPartialViewPathProvider> pathProviders;
@{
    var pathToView = string.Empty;
    foreach (var pathProvider in pathProviders)
    {
        var basicBlock = (IBlockReference<IPublishedElement, IPublishedElement>)Model.Block;
        if (pathProvider.IsProvider(basicBlock))
        {
            pathToView = pathProvider.BuildPartialViewPath(basicBlock);
            break;
        }
    }
    if (string.IsNullOrEmpty(pathToView)) 
    { 
        throw new InvalidOperationException(
            $"No {nameof(IPartialViewPathProvider)} was found to provide a path for the block with content key {Model.Block.Content.Key}, of content type {Model.Block.Content.ContentType.Alias}"
        ); 
    }

    @if (Model.RenderGrid && !Model.IsGridRow && !Model.IsSameAsPrevious) { 
        @:<div class="@Model.RowClasses"> 
        @:<div class="@Model.ColumnClasses"> 
    }
    @if (!string.IsNullOrEmpty(Model.FieldsetErrorClasses))
    {
        @:<div class="@Model.FieldsetErrorClasses"> 
    }
    @await Html.PartialAsync(pathToView, Model.Block)
    @if (!string.IsNullOrEmpty(Model.FieldsetErrorClasses))
    {
        @:</div> 
    }
    @if (Model.RenderGrid && !Model.IsGridRow  && !Model.IsSameAsNext) {
        @:</div> 
        @:</div> 
    }
}