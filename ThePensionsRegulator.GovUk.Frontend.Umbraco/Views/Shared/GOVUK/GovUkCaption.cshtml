@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IOverridableBlockReference<IOverridablePublishedElement,IOverridablePublishedElement>>;
@addTagHelper *, GovUk.Frontend.AspNetCore
@inject IGovUkHeadingClassProvider headingClassProvider
@using ThePensionsRegulator.GovUk.Frontend.Umbraco
@using ThePensionsRegulator.GovUk.Frontend.Umbraco.Services
@using ThePensionsRegulator.Umbraco;
@using ThePensionsRegulator.Umbraco.Core
@using ThePensionsRegulator.Umbraco.Core.Blocks
@using Umbraco.Extensions
@{
    var headingClasses = headingClassProvider.HeadingClasses(Umbraco.AssignedContentItem);
    var caption = Model.Content.Value<string>(PropertyAliases.Caption);
    var cssClasses = ($"{headingClasses.Caption} {Model.Settings?.Value<string>(PropertyAliases.CssClasses)}").TrimEnd();
}
@if (!string.IsNullOrWhiteSpace(caption)) 
{
<span class="@cssClasses">@caption</span>
}