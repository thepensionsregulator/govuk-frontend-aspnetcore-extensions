<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003"
		 InitialTargets="GovUkFrontendUmbraco_Clean">
	<!-- This file is run automatically when the project is built. https://docs.microsoft.com/en-us/visualstudio/msbuild/customize-your-build?view=vs-2019 
	     Run a custom command using Dart SASS installed by the AspNetCore.SassCompiler NuGet package. The default package configuration cannot be used
		 because in Release configuration it removes the comments that are needed to configure the Umbraco rich text editor.
		 -->
	<Target Name="GovUkFrontendUmbraco_BuildSass" BeforeTargets="BeforeBuild">
		<PropertyGroup>
			<UserProfile Condition=" '$(OS)' == 'Windows_NT' ">$(UserProfile)</UserProfile>
			<UserProfile Condition=" '$(OS)' != 'Windows_NT' ">$(HOME)</UserProfile>
		</PropertyGroup>
		<Message Text="Run SassCompiler $(MSBuildProjectFullPath)" Importance="high"/>
		<XmlPeek XmlInputPath="$(MSBuildProjectFullPath)" Query="Project/ItemGroup/PackageReference[@Include='AspNetCore.SassCompiler']/@Version">
			<Output TaskParameter="Result" ItemName="SassCompilerVersion" />
		</XmlPeek>
		<PropertyGroup>
			<SassCompilerVersion>@(SassCompilerVersion)</SassCompilerVersion>
			<SassCompilerPath>$(UserProfile)\.nuget\packages\aspnetcore.sasscompiler\$(SassCompilerVersion)\runtimes\win-x64\src\</SassCompilerPath>
			<SassPath>$(MsBuildThisFileDirectory)Styles\</SassPath>
			<GovUkFrontEndFolder>$(MsBuildThisFileDirectory)..\lib\govuk-frontend\packages\govuk-frontend\src</GovUkFrontEndFolder>
			<WwwrootPath>$(MsBuildThisFileDirectory)wwwroot\ThePensionsRegulator.GovUk.Frontend.Umbraco\css\</WwwrootPath>
		</PropertyGroup>
		<!-- Do not minify backoffice CSS because umb_name comments need to be preserved for TinyMCE -->
		<Exec Command="powershell -NonInteractive -NoProfile Get-Content &quot;$(SassPath)govuk-frontend.scss&quot; | &quot;$(SassCompilerPath)dart.exe&quot; &quot;$(SassCompilerPath)sass.snapshot&quot; --stdin --style=compressed --quiet-deps --silence-deprecation=import --load-path=$(GovUkFrontEndFolder) --load-path=$(SassPath) $(WwwrootPath)govuk-frontend.css"/>
		<Exec Command="powershell -NonInteractive -NoProfile Get-Content &quot;$(SassPath)govuk-umbraco-backoffice.scss&quot; | &quot;$(SassCompilerPath)dart.exe&quot; &quot;$(SassCompilerPath)sass.snapshot&quot; --stdin --quiet-deps --silence-deprecation=import --load-path=$(GovUkFrontEndFolder) --load-path=$(SassPath) $(WwwrootPath)govuk-umbraco-backoffice.css"/>
		<Message Text="SassCompiler complete for $(MSBuildProjectFullPath)" Importance="high"/>
	</Target>
	<!-- uSync files are authored in GovUk.Frontend.Umbraco.ExampleApp. Copy here to include them in the NuGet package. 
		 They must be physically present in the project folder to generate a reference in the <contentFiles> section of the .nuspec file. 
		 If that reference is missing the consuming project will report a build error. -->
	<Target Name="GovUkFrontendUmbraco_CopyUSync" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<DataTypes Include="..\GovUk.Frontend.Umbraco.ExampleApp\uSync\v17\DataTypes\GOVUK*.config"></DataTypes>
			<ContentTypes Include="..\GovUk.Frontend.Umbraco.ExampleApp\uSync\v17\ContentTypes\govuk*.config"></ContentTypes>
		</ItemGroup>
		<Copy SourceFiles="@(DataTypes)"
			DestinationFiles="$(ProjectDir)uSync\ThePensionsRegulator.GovUk.Frontend.Umbraco\DataTypes\%(RecursiveDir)%(Filename)%(Extension)"
			SkipUnchangedFiles="true"/>
		<Copy SourceFiles="@(ContentTypes)"
			DestinationFiles="$(ProjectDir)uSync\ThePensionsRegulator.GovUk.Frontend.Umbraco\ContentTypes\%(RecursiveDir)%(Filename)%(Extension)" 
			SkipUnchangedFiles="true"/>
	</Target>
	
	<!-- Create a version to use as a cache-busting parameter for backoffice customisation -->
	<Target Name="GovUkFrontendUmbraco_GenerateTypeScriptVersion" BeforeTargets="Build">
		<WriteLinesToFile
		  File="Backoffice/src/package-version.generated.ts"
		  Lines="export const PACKAGE_VERSION = '$(Version)'"
		  Overwrite="true" />
	</Target>

	<!-- Clean up obsolete files from previous versions where they would cause a conflict. -->
	<Target Name="GovUkFrontendUmbraco_Clean" Condition="Exists('$(ProjectDir)wwwroot\govuk\')">
		<ItemGroup>
			<!-- Removed in v10.0.0 -->
			<GovUkFrontendUmbraco_DirsToRemove Include="$(ProjectDir)wwwroot\govuk\" />
		</ItemGroup>
		<Message Text="Deleting obsolete files: @(GovUkFrontendUmbraco_DirsToRemove)" />
		<RemoveDir Directories="@(GovUkFrontendUmbraco_DirsToRemove)" />
	</Target>

	<Target Name="TprGovUkFrontendUmbraco_GenerateProps" BeforeTargets="BeforeBuild">
		<!--Generate a .props file so that ThePensionsRegulator.GovUk.Frontend.Umbraco.targets has access to the package version. -->
		<Message Text="ThePensionsRegulator.GovUk.Frontend.Umbraco generating $(ProjectDir)ThePensionsRegulator.GovUk.Frontend.Umbraco.props" Importance="high" />
		<ItemGroup>
			<TprGovUkFrontendUmbracoPropsText Include="TprGovUkFrontendUmbracoPropsText">
				<Text>
					<![CDATA[
<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		<TprGovUkFrontendUmbracoPackageVersion>$(Version)</TprGovUkFrontendUmbracoPackageVersion>
	</PropertyGroup>
</Project>
				]]>
				</Text>
			</TprGovUkFrontendUmbracoPropsText>
			<TprGovUkFrontendUmbracoProps Include="%(TprGovUkFrontendUmbracoPropsText.Text)" />
		</ItemGroup>
		<WriteLinesToFile File="$(ProjectDir)ThePensionsRegulator.GovUk.Frontend.Umbraco.generated.props" Lines="@(TprGovUkFrontendUmbracoProps)" Overwrite="True" />
	</Target>

</Project>
