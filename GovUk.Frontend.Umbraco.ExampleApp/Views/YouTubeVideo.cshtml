@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<YouTubeVideo>
@using Microsoft.Extensions.Configuration;
@inject IConfiguration Configuration
@{
    var useTPRstyles = Configuration.GetValue<bool>("TPRStyles");
}
@section head{
	<title>@Model.PageHeadingOrName()</title>
}

@if (useTPRstyles)
{
    <partial name="GOVUK/BlockGrid" model="Model.GridBlocks" />
    <partial name="GOVUK/BlockList" model="Model.Blocks" />
}
else
{
    <partial name="GOVUK/BLockList" model="Model.GovukBlocks" />
}