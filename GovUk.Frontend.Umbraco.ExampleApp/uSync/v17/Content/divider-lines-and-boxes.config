    <gridBlocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "61baed41-7e14-4615-af1e-0150c6d0a15f",
      "key": "ab53b8e9-4bf0-4cb9-bf2c-8aba70f61d1d",
      "values": []
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "9e34feaf-107d-4032-a22a-4c00acadc480",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EUsing the block grid editor you can pick a \u0027Box\u0027 as a component rather than applying the class, and add any block inside the box.\u00A0\u003C/p\u003E\n\u003Cp\u003EThis example isn\u0027t inside a column layout.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "3fa201d9-0d89-458f-b6dc-f5fb6fc8e10a",
      "key": "a3c8b6d9-90b6-4123-97bb-adf2dcfa6eda",
      "values": []
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "f96fe10a-21c9-404b-8c6d-15a6e931af21",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EBoxes work when placed in a column.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "24431920-98bd-47d0-9bae-82cbe99f9967",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EYou can add bordered boxes too.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "723bf915-e099-4a02-82ad-91dba6f3dba2",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis is a solid box in a one-third single column layout. The single column layout allows a divider to be applied and the width to be configured.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "77726c2e-3248-4fab-bb3a-478e65ba9256",
      "key": "e0f1972f-52af-491e-a0dd-b53b0bbc75d4",
      "values": []
    },
    {
      "contentTypeKey": "61baed41-7e14-4615-af1e-0150c6d0a15f",
      "key": "82366f5c-f9b0-4a38-9434-f26b560ec039",
      "values": []
    },
    {
      "contentTypeKey": "3fa201d9-0d89-458f-b6dc-f5fb6fc8e10a",
      "key": "7c931c79-8127-425a-98b9-2e3c953825ab",
      "values": []
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "eb657806-e8ed-4b91-a142-a48bd2a35eb2",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis content is within a column, in a box with the style set to bordered.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "435f4ca4-98a3-4624-8e74-90c3127e3040",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis content is in another box, within a column in a box with the style set to bordered.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "61baed41-7e14-4615-af1e-0150c6d0a15f",
      "key": "2cf19a5a-19fd-49f4-a3f5-ed6b093f1f0d",
      "values": []
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "853131dc-44cd-40d2-b0ff-76dde6e39606",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis is a box directly within another box.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "7a673e01-a687-45f3-ad99-f4067720b0ec",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis is a box directly within another box. There should be even spacing between this box and the box above, and between this box and the outer box.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "650d7119-e9cf-4c26-a08c-21cf2ffbbbbc",
      "key": "3da0a195-884f-48ad-bb19-6a44482a444f",
      "values": []
    },
    {
      "contentTypeKey": "3fa201d9-0d89-458f-b6dc-f5fb6fc8e10a",
      "key": "98c9e716-6247-4fa1-bb6d-8cfa12a0dde7",
      "values": []
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "b9ec4087-9ad7-47ad-ae16-f6972a2d2cc0",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis is a box inside the second column of the two-thirds/one-third layout.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "61baed41-7e14-4615-af1e-0150c6d0a15f",
      "key": "9ef9f127-c3fd-4077-8319-1ea10c660319",
      "values": []
    },
    {
      "contentTypeKey": "f7721eea-7712-4d9c-91e4-9c04f0ad3036",
      "key": "9709ea00-160e-4959-b8a9-33e2182dbf9c",
      "values": []
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "48c81075-5b70-4c72-8eb0-45f730db212e",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis box has a three-column layout inside.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "13ec193a-3f74-4463-b0e5-947aa0018040",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis box has a three-column layout inside.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "6d4330de-355c-4e27-879f-fa8fbae985d1",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis box has a three-column layout inside.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "49f62a11-de7a-46b4-9e76-0fd8b26ddde0",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis is a box inside the first column of a two-column layout inside a two-thirds/one-third layout.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "85fc4728-9637-4a67-85b9-e0ee9a54fed3",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis is a box inside the first column of a two-column layout inside a two-thirds/one-third layout.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "382a58ed-d846-4074-8db8-375b553b2c7e",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EBoxes can be within nested column layouts. This text is inside a two-thirds/one-third layout, and is followed by a two-column layout with boxes inside each column.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "3fa201d9-0d89-458f-b6dc-f5fb6fc8e10a",
      "key": "b7e87702-ccc0-46bb-8ce5-c3f78cba7c8f",
      "values": []
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "704aa73f-941b-4903-9e02-09e167df6058",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis is the same example, except that the columns remain stacked at the tablet breakpoint.\u003C/p\u003E"
          }
        }
      ]
    },
