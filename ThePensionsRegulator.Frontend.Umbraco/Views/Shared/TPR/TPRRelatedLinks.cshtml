@using ThePensionsRegulator.Frontend.Umbraco
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Web.Common
@using GovUkPropertyAliases = GovUk.Frontend.Umbraco.PropertyAliases
@inject UmbracoHelper Umbraco
@addTagHelper *, ThePensionsRegulator.Frontend

@{
    var cssClasses = Model.Settings.Value<bool>(TprPropertyAliases.RelatedLinksBar) ? string.Empty : "tpr-related-links--no-bar";
    var additionalCssClasses = Model.Settings.Value<string>(GovUkPropertyAliases.CssClasses);
    if (!string.IsNullOrWhiteSpace(additionalCssClasses)) { cssClasses += " " + additionalCssClasses; }

    var heading = Model.Content.Value<string>(TprPropertyAliases.RelatedLinksHeading);
    if (string.IsNullOrWhiteSpace(heading)) { heading = Umbraco.GetDictionaryValueOrDefault("TPR Related links heading", "Related"); }
    var headingId = heading.Replace(" ", "_");

    var links = Model.Content.Value<IEnumerable<Link>>(TprPropertyAliases.RelatedLinksLinks);
}

<tpr-related-links class="@cssClasses" aria-label="List of related links">

    <tpr-related-links-heading id="@headingId">@heading</tpr-related-links-heading>

    @foreach (var link in links) {
        <tpr-related-link href="@link.Url" aria-labelledby="@headingId">@link.Name</tpr-related-link>
    }

</tpr-related-links>