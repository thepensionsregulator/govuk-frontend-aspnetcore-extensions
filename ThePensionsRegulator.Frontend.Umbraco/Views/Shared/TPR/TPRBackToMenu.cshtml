@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<OverridableBlockListItem>;
@addTagHelper *, ThePensionsRegulator.Frontend
@using GovUk.Frontend.Umbraco.Models
@using GovUk.Frontend.Umbraco;
@using ThePensionsRegulator.Umbraco.Blocks;
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@using TprPropertyAliases = ThePensionsRegulator.Frontend.Umbraco.PropertyAliases;
@{
    var text = Model.Content.Value<string>(TprPropertyAliases.TprBackToMenuText);
    var link = Model.Content.Value<Link>(TprPropertyAliases.TprBackToMenuLink);
    if (link is null) { return; }
    var cssClasses = Model.Settings?.Value<string>(PropertyAliases.CssClasses);
}
<tpr-back-to-menu href="@link.Url" id="@Model.Content.Key" class="@cssClasses">@text</tpr-back-to-menu>