          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe next example shows section cards inside a \u0027Nested box\u0027, which is inside a \u0027Three quarters\u0027 layout block.\u003C/p\u003E"
          }
        }
      ]
    },
