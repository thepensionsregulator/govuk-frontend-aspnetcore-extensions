    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "text": {
        "markup": "<p>Videos will adapt to the size of their container, therefore they work in a multi-column layout using the block grid.</p>\n<p>If a transcript is available it can be linked from under the video.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/26d7be5d48624ef89fc296495501d377"
