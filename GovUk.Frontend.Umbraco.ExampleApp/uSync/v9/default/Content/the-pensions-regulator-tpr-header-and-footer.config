    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "text": {
        "markup": "<h2 class=\"govuk-heading-s\">Footer bar</h2>\n<p>The TPR footer bar is one component usually present at the bottom of pages across the site</p>\n<p>It supports localisation / culture variance and consists&nbsp;of three areas:</p>\n<ul>\n<li>the TPR logo</li>\n<li>links (optional)</li>\n<li>a copyright statement</li>\n</ul>\n<p>It is possible for the logo not to be linked, as demonstrated in the second example.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/8378bb1f22574da297c3876adae466b4"
    }
  ],
