@using System.Linq
@using GovUk.Frontend.Umbraco.ExampleApp.Services
@using ThePensionsRegulator.Frontend.Services
@using ThePensionsRegulator.Frontend.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Web.Common
@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.SessionTimeoutPreview>
@inject UmbracoHelper Umbraco
@inject IPublishedValueFallback publishedValueFallback
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@section head {
    <title>@Model.Name</title>
    <link rel="stylesheet" href="~/css/session-timeout-preview.css" asp-append-version="true" />
}
@section secondary_navigation {}
@{
    var settings = Umbraco.ContentAtRoot().SingleOrDefault(x => x.ContentType.Alias == "settings");
    var selectedMessageKey = Context?.Request?.Query["messageKey"].ToString();
    var messages = SessionTimeoutDemoMessages.GetMessages(settings, publishedValueFallback);
    var selected = TprSessionTimeOutMessageSelector.SelectByKey(messages, selectedMessageKey);
    if (selected is not null)
    {
        selected.Settings = new SessionTimeoutSettings
        {
            RemainingTime = TimeSpan.FromSeconds(125),
            ExtensionLength = TimeSpan.FromMinutes(3),
            WarningBeforeExpiry = TimeSpan.FromMinutes(2),
            ExpiryUrl = "/session-timeout"
        };
    }
}

<div class="govuk-width-container">
    <p class="govuk-body">
        <a class="govuk-link" href="/session-timeout">Back to session-timeout variants</a>
    </p>
    @if (selected != null)
    {
        <h1 class="govuk-heading-l">Session timeout preview</h1>
        <p class="govuk-body">The warning will appear after 5 seconds, with 2 minutes remaining. It displays 2 minutes for a full minute. When 1 minute remains, it switches to 60 seconds and counts down to zero.</p>
        <p class="govuk-body">Continuing simulates a successful extension to 3 minutes; the warning will appear again with 2 minutes remaining.</p>
        <p class="govuk-body">This preview does not extend a real session. When the countdown reaches zero, you will return to the session-timeout examples page.</p>
        <partial name="TPR/TPRSessionTimeOutWarning" model="selected" />
    }
    else
    {
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text"><span class="govuk-warning-text__assistive">Warning</span>No session-timeout message variants are configured.</strong>
        </div>
    }
</div>

@section scripts {
    <script src="~/js/session-timeout-preview.js" type="module" asp-append-version="true"></script>
}