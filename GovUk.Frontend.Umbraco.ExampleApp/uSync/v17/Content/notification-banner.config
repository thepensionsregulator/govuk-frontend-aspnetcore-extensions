          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EUse the green version of the notification banner to confirm that something they\u2019re expecting to happen has happened.\u003C/p\u003E"
          }
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EDo not use a notification banner to tell users that they\u2019ve finished using a linear service. Use a\u003Cspan\u003E\u00A0\u003C/span\u003E\u003Ca href=\u0022https://design-system.service.gov.uk/patterns/confirmation-pages/\u0022 class=\u0022govuk-notification-banner__link\u0022\u003Econfirmation page\u003C/a\u003E\u003Cspan\u003E\u00A0instead.\u003C/span\u003E\u003C/p\u003E"
          }
        }
      ]
