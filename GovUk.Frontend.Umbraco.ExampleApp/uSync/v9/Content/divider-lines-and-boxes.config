  "contentData": [
    {
      "contentTypeKey": "61baed41-7e14-4615-af1e-0150c6d0a15f",
      "udi": "umb://element/ab53b8e94bf04cb9bf2c8aba70f61d1d"
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "udi": "umb://element/9e34feaf107d4032a22a4c00acadc480",
      "text": {
        "markup": "<p>Using the block grid editor you can pick a 'TPR box' as a component rather than applying the class, and add any block inside the box.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      }
    },
    {
      "contentTypeKey": "3fa201d9-0d89-458f-b6dc-f5fb6fc8e10a",
      "udi": "umb://element/a3c8b6d990b6412397bbadf2dcfa6eda"
    },
    {
      "contentTypeKey": "61baed41-7e14-4615-af1e-0150c6d0a15f",
      "udi": "umb://element/8912f628f5da4f0185c7dda5e81f68d3"
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "udi": "umb://element/f96fe10a21c9404b8c6d15a6e931af21",
      "text": {
        "markup": "<p>Boxes work when placed in a column.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      }
    },
    {
      "contentTypeKey": "61baed41-7e14-4615-af1e-0150c6d0a15f",
      "udi": "umb://element/d90709fea0c3482ab9c9c3cb811c355d"
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "udi": "umb://element/2443192098bd47d09bae82cbe99f9967",
      "text": {
        "markup": "<p>You can add bordered boxes too.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      }
    }
  ],
