      "hint": {
        "markup": "<p><span class=\"pl-s\">This must be either</span></p>\n<ul>\n<li>6 numbers or</li>\n<li>7 numbers or</li>\n<li>the letters SC followed by 6 numbers</li>\n</ul>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "label": "Registered charity number",
      "udi": "umb://element/db48af2f54e642bc917c3f4ec4b01a51"
    },
    {
      "contentTypeKey": "fe2dd0de-55a9-4249-be03-6896aa719974",
      "hint": {
        "markup": "<p>This must be either</p>\n<ul>\n<li>8 numbers or</li>\n<li>2 letters and 6 numbers or</li>\n<li>1 letter and 7 numbers</li>\n</ul>",
