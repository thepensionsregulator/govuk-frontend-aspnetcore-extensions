{
  "name": "govuk-frontend-aspnetcore-extensions",
  "version": "1.0.0",
  "description": "Adds client-side validation and editing in Umbraco to https://github.com/gunndabad/govuk-frontend-aspnetcore",
  "main": "index.js",
  "repository": "https://github.com/thepensionsregulator/govuk-frontend-aspnetcore-extensions.git",
  "author": "The Pensions Regulator <no-reply@tpr.gov.uk>",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "GovUk.Frontend.AspNetCore.Extensions",
      "ThePensionsRegulator.Frontend"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "wwwroot/govuk/**/*.js"
    ],
    "transform": {},
    "moduleNameMapper": {
      "/govuk-frontend.min.js$": "<rootDir>/ThePensionsRegulator.Frontend/__mocks__/govuk/all.min.js"
    }
  },
  "type": "module",
  "resolutions": {
    "json5": "2.2.2"
  },
  "overrides": {
    "minimatch": ">=10.2.1"
  },
  "dependencies": {
    "brace-expansion": "^1.1.13",
    "govuk-frontend": "^5.13.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --watchAll=false --reporters=jest-junit --reporters=default --coverage --coverageReporters=cobertura",
    "govuk": "cd GovUk.Frontend.AspNetCore.Extensions.ConformanceTests && npm install"
  }
}
