@using GovUk.Frontend.Umbraco
@using ThePensionsRegulator.Frontend.Umbraco
@using ThePensionsRegulator.Umbraco
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Routing
@using Umbraco.Extensions

@inject IPublishedUrlProvider publishedUrlProvider
@{
    IPublishedContent currentPage = Model.CurrentPage;
    IPublishedContent rootAncestor = Model.RootAncestor;
    string[] blacklistedUrls = Model.BlacklistedUrls;
}

<nav class="side-nav">
    <h2>
        <button type="button" class="govuk-link side-nav-mobile-expand-toggle">@rootAncestor.Name</button>
        <a class="govuk-link side-nav-desktop-link" href="@rootAncestor.Url(publishedUrlProvider)">@rootAncestor.Name</a>
    </h2>
    <ul class="side-nav-list">
        @foreach (IPublishedContent level1Child in rootAncestor.Children)
        {
            @if (blacklistedUrls.Contains(level1Child.Url(publishedUrlProvider))) { continue; }

            @if ((level1Child == currentPage || currentPage.Ancestors().Contains(level1Child)) && level1Child.Children().Any())
            {
                <li class="side-nav-list-item-expanded">
                    <a class="govuk-link" href="@level1Child.Url(publishedUrlProvider)">@level1Child.Name</a>
                    <ul>
                        @foreach (IPublishedContent level2Child in level1Child.Children())
                        {
                            @if (blacklistedUrls.Contains(level2Child.Url(publishedUrlProvider))) { continue; }

                            @if ((level2Child == currentPage || currentPage.Ancestors().Contains(level2Child)) && level2Child.Children().Any())
                            {
                                <li>
                                    <a class="govuk-link" href="@level2Child.Url(publishedUrlProvider)">@level2Child.Name</a>
                                    <ul>
                                        @foreach (IPublishedContent level3Child in level2Child.Children())
                                        {
                                            @if (blacklistedUrls.Contains(level3Child.Url(publishedUrlProvider))) { continue; }

                                            <li>
                                                <a class="govuk-link" href="@level3Child.Url(publishedUrlProvider)">@level3Child.Name</a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="govuk-link" href="@level2Child.Url(publishedUrlProvider)">@level2Child.Name</a>
                                </li>
                            }
                        }
                    </ul>
                </li>
            }
            else
            {
                <li>
                    <a class="govuk-link" href="@level1Child.Url(publishedUrlProvider)">@level1Child.Name</a>
                </li>
            }
        }
    </ul>
</nav>