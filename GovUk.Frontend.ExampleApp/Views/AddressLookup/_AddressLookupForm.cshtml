        <govuk-input for="BillingAddress.PostTown" class="govuk-input--width-20" autocomplete="address-level2"
                     input-attributes="@(new Dictionary<string, string?> { { "data-address-lookup", "town-or-city" } })">
            <govuk-input-label>Town or city</govuk-input-label>
            @if (ViewContext.ModelState.ContainsKey("BillingAddress.PostTown") &&
