    {
      "contentTypeKey": "6da482da-a53c-4df3-8fd4-697a7d91bbac",
      "hint": {
        "markup": "<p>The validation will fail if no file is provided. The choose file dialog will only allow selection of a CSV file based on its file extension, but any file can be uploaded using drag and drop.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "label": "Upload a CSV spreadsheet",
      "udi": "umb://element/e5df46d4ead24379b9f56d91d36a14db"
