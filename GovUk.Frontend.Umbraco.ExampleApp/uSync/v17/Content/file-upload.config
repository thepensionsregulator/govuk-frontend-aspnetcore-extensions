              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe validation will fail if the file is above 5MB.\u003C/p\u003E"
          }
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Limit file size"
        }
      ]
