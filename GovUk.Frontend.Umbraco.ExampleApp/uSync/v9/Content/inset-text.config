  "contentData": [
    {
      "contentTypeKey": "40bb2a3e-3d75-4ec1-9134-e0c46c6f04a0",
      "text": {
        "markup": "<p>Use the <a href=\"https://design-system.service.gov.uk/components/inset-text/\">inset text</a> component to differentiate a block of text from the content that surrounds it.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/b4cbfa892b914313bfa634d6a9e00d38"
    },
    {
      "caption": "Example application in Umbraco",
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "udi": "umb://element/d0fb3de2fbf34c76b0dce9e80cdcf952"
    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
      "text": "",
      "udi": "umb://element/d788e6b093124b7b8548fee0a6808d2d"
    },
    {
      "contentTypeKey": "40bb2a3e-3d75-4ec1-9134-e0c46c6f04a0",
      "text": {
        "markup": "<p class=\"custom-class\">When there is a single paragraph with no class applied, the surrounding <strong>p </strong>element should be removed. This inset text component has just one paragraph but a custom class is applied, so the&nbsp;<strong>p</strong> element should be kept.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/223e6dec830f474bb4cd2938036b6e0e"
    },
    {
      "contentTypeKey": "40bb2a3e-3d75-4ec1-9134-e0c46c6f04a0",
      "text": {
        "markup": "<p class=\"govuk-body\">Inset text components can (although rarely should) contain multiple paragraphs.</p>\n<p class=\"custom-class\">Custom classes can be applied when there are multiple paragraphs.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/92987d19fcb741d78efdb932f81617ca"
    }
