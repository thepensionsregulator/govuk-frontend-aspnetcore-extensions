@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IOverridableBlockReference<IOverridablePublishedElement,IOverridablePublishedElement>>;
@addTagHelper *, GovUk.Frontend.AspNetCore
@using ThePensionsRegulator.GovUk.Frontend.Umbraco
@using ThePensionsRegulator.Umbraco;
@using ThePensionsRegulator.Umbraco.Core
@using ThePensionsRegulator.Umbraco.Core.Blocks
@using Umbraco.Cms.Core.Strings;
@using Umbraco.Extensions
@{
    if (!Int32.TryParse(Model.Settings?.Value<string>(PropertyAliases.HeadingLevel)?.Replace("Heading ", string.Empty), out var headingLevel))
    {
        headingLevel = 1;
    }
    var body = Model.Content.Value<IHtmlEncodedString>(PropertyAliases.PanelText);
    var cssClasses = Model.Settings?.Value<string>(PropertyAliases.CssClasses);
}
<govuk-panel heading-level="@headingLevel" class="@cssClasses">
    <govuk-panel-title>@(Model.Content.Value<string>(PropertyAliases.PanelHeading))</govuk-panel-title>
    @if (!string.IsNullOrEmpty(body?.ToHtmlString())) 
    {
        <govuk-panel-body>@body</govuk-panel-body>
    }
</govuk-panel>