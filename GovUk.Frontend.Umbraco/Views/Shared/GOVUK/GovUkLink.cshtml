@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<OverridableBlockListItem>;
@addTagHelper *, GovUk.Frontend.AspNetCore
@using GovUk.Frontend.Umbraco;
@using GovUk.Frontend.Umbraco.Models
@using ThePensionsRegulator.Umbraco.Core.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@{
    var text = Model.Content.Value<string>(PropertyAliases.LinkText);
    var link = Model.Content.Value<Link>(PropertyAliases.Link);
    var cssClasses = (" " + Model.Settings?.Value<string>(PropertyAliases.CssClasses)).TrimEnd();
}
@if (link is not null)
{
    <a href="@link.Url" class="govuk-link@(cssClasses)" id="@Model.Content.Key">@text</a>
}