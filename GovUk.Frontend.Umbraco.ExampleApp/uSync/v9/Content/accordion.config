                {
                  "contentTypeKey": "40bb2a3e-3d75-4ec1-9134-e0c46c6f04a0",
                  "udi": "umb://element/136f8a232ef84c839e08e4ae7fb9ca3c",
                  "text": {
                    "markup": "<p>Inset text and other non-forms components are allowed inside an accordion.</p>",
                    "blocks": {
                      "contentData": [],
                      "settingsData": []
                    }
                  }
                },
                {
                  "contentTypeKey": "9389c5e5-ce97-4211-97c5-f2cd173ca648",
