  <Properties>
    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "40bb2a3e-3d75-4ec1-9134-e0c46c6f04a0",
      "key": "b4cbfa89-2b91-4313-bfa6-34d6a9e00d38",
