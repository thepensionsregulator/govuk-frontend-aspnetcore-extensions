@model AddressLookupViewModel
@{
    ViewData["Title"] = "Address lookup primary address data provided";
}

<span class="govuk-caption-xl">Example application</span>

<div class="govuk-grid-row govuk-grid-row--tpr-divider">
    <div class="govuk-grid-column govuk-grid-column-full">
        <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column govuk-grid-column-two-thirds-from-desktop">
        <p class="govuk-body">
            If the viewmodel for a page contains data for one address but not the other, the relevant component
            will be rendered in the &lsquo;confirmed&rsquo; view. The other will be rendered in the &lsquo;search&rsquo; view.
        </p>

        <h2 class="govuk-heading-l">Address</h2>

        <form asp-controller="AddressLookup" asp-action="PostPrimaryDataProvided" method="post" novalidate>
            <partial name="_AddressLookupForm" model="Model" />
        </form>
    </div>
</div>

@section scripts {
    <partial name="GOVUK/Validation" />
    <script src="~/_Content/ThePensionsRegulator.Frontend/tpr/address-lookup/index.js" type="module"></script>
}