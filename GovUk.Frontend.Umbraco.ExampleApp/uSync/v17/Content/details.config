  </Info>
  <Properties>
    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "9d15adb9-fb63-4b20-ada3-fc9239a72a8c",
      "key": "a24f9bef-7484-435c-9164-f714c99b62b7",
      "udi": null,
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "When to use the details component"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EUse the \u003Ca href=\u0022https://design-system.service.gov.uk/components/details/\u0022\u003Edetails component\u003C/a\u003E to make a page easier to scan when it contains information that only some users will need.\u0026nbsp;\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "key": "de9065cf-0deb-4071-887a-4b1f3a49dde9",
      "udi": null,
      "values": [
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Example application in Umbraco"
        }
      ]
    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
      "key": "ce2560c2-cad9-4bc1-863e-34066ba03ee0",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "9d15adb9-fb63-4b20-ada3-fc9239a72a8c",
      "key": "62898fa9-1895-46a4-b1e7-9f075d06a7a7",
      "udi": null,
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Custom classes are supported when there\u0027s only one paragraph"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp class=\u0022custom-class\u0022\u003EWhen there is a single paragraph with no class applied, the surrounding \u003Cstrong\u003Ep \u003C/strong\u003Eelement should be removed. This details component is a single paragraph but a custom class is applied, so the\u0026nbsp;\u003Cstrong\u003Ep\u003C/strong\u003E element should be kept.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "9d15adb9-fb63-4b20-ada3-fc9239a72a8c",
      "key": "de0b39d1-f30d-4d83-ad1c-8007a4e63b51",
      "udi": null,
      "values": [
        {
          "alias": "summary",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Complex rich text is supported"
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EDetails components can contain many paragraphs of detailed information.\u003C/p\u003E\n\u003Cp class=\u0022custom-class\u0022\u003ECustom classes can be applied when there are multiple paragraphs.\u003C/p\u003E\n\u003Cp style=\u0022text-align: center;\u0022\u003EText can be centred.\u003C/p\u003E\n\u003Cp style=\u0022text-align: right;\u0022\u003EText can be right aligned.\u003C/p\u003E\n\u003Cp style=\u0022text-align: left; padding-left: 40px;\u0022\u003EText can be indented from the left.\u003C/p\u003E\n\u003Cp style=\u0022text-align: left; padding-left: 80px;\u0022\u003EText can be indented from the left.\u003C/p\u003E\n\u003Cp style=\u0022text-align: left; padding-left: 120px;\u0022\u003EText can be indented from the left.\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli style=\u0022text-align: left;\u0022\u003EUnordered lists are allowed\u003C/li\u003E\n\u003Cli style=\u0022text-align: left;\u0022\u003EUnordered lists are allowed\u003C/li\u003E\n\u003C/ul\u003E\n\u003Col\u003E\n\u003Cli style=\u0022text-align: left;\u0022\u003EOrdered lists are allowed\u003C/li\u003E\n\u003Cli style=\u0022text-align: left;\u0022\u003EOrdered lists are allowed\u003C/li\u003E\n\u003C/ol\u003E\n\u003Ch2 class=\u0022govuk-heading-m\u0022 style=\u0022text-align: left;\u0022\u003ETables and subheadings are allowed\u003C/h2\u003E\n\u003Ctable\u003E\n\u003Cthead\u003E\n\u003Ctr\u003E\n\u003Cth\u003EHeader 1\u003C/th\u003E\n\u003Cth\u003EHeader 2\u003C/th\u003E\n\u003C/tr\u003E\n\u003C/thead\u003E\n\u003Ctbody\u003E\n\u003Ctr\u003E\n\u003Ctd\u003EData 1\u003C/td\u003E\n\u003Ctd\u003EData 2\u003C/td\u003E\n\u003C/tr\u003E\n\u003C/tbody\u003E\n\u003C/table\u003E"
          }
        }
      ]
    }
  ],
