<?xml version="1.0" encoding="utf-8"?>
<DataType Key="2f68935f-27e3-4893-95e7-ad69a4cffdfe" Alias="GOV.UK Rich text editor (Text)" Level="2">
  <Info>
    <Name>GOV.UK Rich text editor (Text)</Name>
    <EditorAlias>Umbraco.RichText</EditorAlias>
    <EditorUIAlias>Umb.PropertyEditorUi.TinyMCE</EditorUIAlias>
    <Folder>GOV.UK</Folder>
  </Info>
  <Config><![CDATA[{
  "dimensions": {
    "width": 800,
    "height": 650
  },
  "hideLabel": true,
  "ignoreUserStartNodes": false,
  "maxImageSize": 500,
  "mode": "Classic",
  "overlaySize": "small",
  "stylesheets": [
    "/govuk-umbraco-backoffice.css",
    "/site.css"
  ],
  "toolbar": [
    "removeformat",
    "styles",
    "bold",
    "italic",
    "alignleft",
    "aligncenter",
    "alignright",
    "bullist",
    "numlist",
    "outdent",
    "indent",
    "link",
    "unlink",
    "anchor",
    "table",
    "subscript",
    "superscript",
    "charmap"
  ],
  "useLiveEditing": false
}]]></Config>
</DataType>