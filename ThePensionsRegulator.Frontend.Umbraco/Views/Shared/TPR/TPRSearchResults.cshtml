@using ThePensionsRegulator.Frontend.Umbraco
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Web.Common
@using Microsoft.Extensions.Configuration
@using GovUkPropertyAliases = GovUk.Frontend.Umbraco.PropertyAliases
@inject IConfiguration configuration
@addTagHelper *, ThePensionsRegulator.Frontend

@{
    var searchResultsSection = configuration.GetSection("SearchResultsApiEndpoints");

    var heading = Model.Content.Value<string>(TprPropertyAliases.RelatedLinksHeading);
    var links = Model.Content.Value<IEnumerable<Link>>(TprPropertyAliases.FooterLinks);

    var cssClasses = Model.Settings.Value<string>(GovUkPropertyAliases.CssClasses);
    var headingClass = Model.Settings.Value<string?>(TprPropertyAliases.HeadingClass);

    if (!Int32.TryParse(Model.Settings?.Value<string>(GovUkPropertyAliases.HeadingLevel)?.Replace("Heading ", string.Empty), out int headingLevel))
    {
        headingLevel = 2;
    }

    if (string.IsNullOrEmpty(headingClass))
    {
        headingClass = "govuk-heading-l";
    }
}

<tpr-search-results class="@cssClasses" content-by-id-url=@searchResultsSection["ContentByIdUrl"] search-content-url=@searchResultsSection["SearchContentUrl"] popular-content-url=@searchResultsSection["PopularContentUrl"]>
    <tpr-search-results-input heading-level=@headingLevel govuk-heading-class=@headingClass>@heading</tpr-search-results-input>
    <tpr-search-results-footer-links>
        @foreach(var link in links)
        {
            <a href="@link.Url" target="@link.Target">@link.Name</a>
        }
    </tpr-search-results-footer-links>
</tpr-search-results>