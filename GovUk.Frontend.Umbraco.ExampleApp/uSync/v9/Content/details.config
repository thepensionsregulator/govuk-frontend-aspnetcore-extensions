  "contentData": [
    {
      "contentTypeKey": "9d15adb9-fb63-4b20-ada3-fc9239a72a8c",
      "summary": "When to use the details component",
      "text": {
        "markup": "<p>Use the <a href=\"https://design-system.service.gov.uk/components/details/\">details component</a> to make a page easier to scan when it contains information that only some users will need.&nbsp;</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/a24f9bef7484435c9164f714c99b62b7"
    },
    {
      "caption": "Example application in Umbraco",
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "udi": "umb://element/de9065cf0deb4071887a4b1f3a49dde9"
    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
