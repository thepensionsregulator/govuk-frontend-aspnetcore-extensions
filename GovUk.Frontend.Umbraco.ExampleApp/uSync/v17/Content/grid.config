      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis paragraph is in the first of two equal columns. The columns will stack at small screen sizes by default.\u003C/p\u003E"
          }
        }
      ]
    },
    {
