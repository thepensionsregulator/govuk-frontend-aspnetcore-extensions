@using GovUk.Frontend.Umbraco
@using ThePensionsRegulator.Frontend.Umbraco
@using ThePensionsRegulator.Umbraco
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IBlockReference<IPublishedElement, IPublishedElement>>

@{
    var typedMediaPickerSingle = Model.Content.Value<Umbraco.Cms.Core.Models.MediaWithCrops>(TprPropertyAliases.Image);
    if (typedMediaPickerSingle is not null)
    {
        var cssClasses = new List<string>() { TprClassNames.Image };
        if (Model.Settings is not null)
        {
            cssClasses.AddRange(new TokenList(Model.Settings, PropertyAliases.CssClasses));
            if (Model.Settings.Value<string>(TprPropertyAliases.ImageSize) != TprImageSize.RetainOriginal)
            {
                cssClasses.Add(TprClassNames.ImageStretch);
            }

            if (Model.Settings.Value<bool>(TprPropertyAliases.ImageSpaceAfter) == false)
            {
                cssClasses.Add(TprClassNames.ImageNoSpaceAfter);
            }
        }
        else 
        { 
            cssClasses.Add(TprClassNames.ImageStretch); 
        }

        <img src="@typedMediaPickerSingle.MediaUrl()" alt="@typedMediaPickerSingle.Name" class="@string.Join(" ", cssClasses)" />
    }
}
