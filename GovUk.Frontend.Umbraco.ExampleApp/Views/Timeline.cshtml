@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Timeline>
@using Microsoft.Extensions.Configuration;
@inject IConfiguration Configuration
@{
    var useTPRstyles = Configuration.GetValue<bool>("TPRStyles");
}
@section head {
	<title>@Model.PageHeadingOrName()</title>
}

@if (useTPRstyles)
{
    @:<div class="govuk-width-container govuk-!-margin-top-5"><div class="govuk-grid-row govuk-grid-row--tpr-divider">
        <div class="govuk-grid-column govuk-grid-column-full">
            <h1 class="govuk-heading-l">@Model.Name</h1>
        </div>
    @:</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column govuk-grid-column-two-thirds-from-desktop">
        <p class="govuk-body">
            Use the timeline component to show a linear record of events that have already happened or are due to happen. You can apply your own classes in addition to the provided classes so you can control how the timeline looks.
        </p>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column govuk-grid-column-two-thirds-from-desktop">
<div class=" govuk-grid-row--tpr-divider ">
<h2 class="govuk-heading-m">Example content</h2>
</div>
        <tpr-timeline>
            <tpr-timeline-item date="9 Jan 2005" heading="Starting title">
            </tpr-timeline-item>
            <tpr-timeline-item date="31 Jan 2025" heading="Today's date" class="tpr-timeline__item--orange">
                <tpr-timeline-item-content>
                    <h3 class="govuk-heading-m">Example of custom content</h3>
                <p class="govuk-body">You can fill space with your own HTML.</p>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
            <tpr-timeline-item date="9 Jun 2025" heading="Example deadline style" class="tpr-timeline__item--red">
                <tpr-timeline-item-content>
                    <p class="govuk-body">You can add custom content here too.</p>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
        </tpr-timeline>

<h2 class="govuk-heading-m">Example of tags and attributes</h2>
        <tpr-timeline hide-tail="true" heading-level="3" aria-title="Custom heading for Timeline">
            <tpr-timeline-item date="tpr-timeline-item date attribute" heading="tpr-timeline-item heading attribute" class="customClass">
                <tpr-timeline-item-content>
                <p class="govuk-body">Content inside tpr-timeline-item-content</p>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
            <tpr-timeline-item date="Set custom heading levels" heading="This is a H3 heading">
                <tpr-timeline-item-content>
                <p class="govuk-body">You can set the heading level by setting the <code>heading-level</code> attribute on the <code>tpr-timeline</code> element. 
                The values range between 1-6.</p>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
            <tpr-timeline-item date="Small date" class="tpr-timeline__datetime-s">
                <tpr-timeline-item-content>
                <p class="govuk-body">You can make the date small size by adding the <code>tpr-timeline__datetime-s</code> class on the <code>tpr-timeline-item</code> element.</p>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
            <tpr-timeline-item date="Medium date" class="tpr-timeline__datetime-m">
                <tpr-timeline-item-content>
                <p class="govuk-body">You can make the date medium size by adding the <code>tpr-timeline__datetime-m</code> class on the <code>tpr-timeline-item</code> element.</p>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
            <tpr-timeline-item date="Large date" class="tpr-timeline__datetime-l">
                <tpr-timeline-item-content>
                <p class="govuk-body">You can make the date large size by adding the <code>tpr-timeline__datetime-l</code> class on the <code>tpr-timeline-item</code> element.</p>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
            <tpr-timeline-item date="Custom accessibility title">
                <tpr-timeline-item-content>
                <p class="govuk-body">You can set a custom <code>aria-title</code> attribute on the <code>tpr-timeline</code> element. 
                This will output an <code>aria-label</code> on the timeline element which is good for accessibility. If not specified, 
                it defaults to 'Timeline'.</p>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
            <tpr-timeline-item date="31 Jan 2025" heading="Today's date" class="tpr-timeline__item--orange">
                <tpr-timeline-item-content>
                    <h3 class="govuk-heading-m">Example of custom content</h3>
                <p class="govuk-body">You can fill space with your own HTML.</p>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
            <tpr-timeline-item date="9 Jun 2025" heading="Example of no tail" class="tpr-timeline__item--orange">
                <tpr-timeline-item-content>
                    <p class="govuk-body">Notice that the line does not continue thanks to hide-tail="true" on the parent tpr-timeline tag.</p>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
        </tpr-timeline>


<h2 class="govuk-heading-m">Example of different colours</h2>
<style>
    .tpr-timeline__item--whatever1,
    .tpr-timeline__item--whatever1::before,
    .tpr-timeline__item--whatever1:last-of-type::after
    {
        border-color: #483b8b;
    }

    .tpr-timeline__item--whatever2,
    .tpr-timeline__item--whatever2::before,
    .tpr-timeline__item--whatever2:last-of-type::after
    {
        border-color: #5949ac;
    }

    .tpr-timeline__item--whatever3,
    .tpr-timeline__item--whatever3::before,
    .tpr-timeline__item--whatever3:last-of-type::after
    {
        border-color: #7466be;
    }

    .tpr-timeline__item--whatever4,
    .tpr-timeline__item--whatever4::before,
    .tpr-timeline__item--whatever4:last-of-type::after
    {
        border-color: #9287cc;
    }

    .tpr-timeline__item--whatever5,
    .tpr-timeline__item--whatever5::before,
    .tpr-timeline__item--whatever5:last-of-type::after
    {
        border-color: #b0a7da;
    }
</style>
        <tpr-timeline>
            <tpr-timeline-item date="Default">
            </tpr-timeline-item>
            <tpr-timeline-item date="Custom colour 1"  class="tpr-timeline__item--whatever1">
            </tpr-timeline-item>
            <tpr-timeline-item date="Custom colour 2"  class="tpr-timeline__item--whatever2">
            </tpr-timeline-item>
            <tpr-timeline-item date="Custom colour 3"  class="tpr-timeline__item--whatever3" heading="How to use line colours">
                <tpr-timeline-item-content>
                <p class="govuk-body">The default colour for the line of the timeline is violet. There are two more colours provided:
                    <ul class="govuk-body">
                            <li>Orange - you can set this by adding <code>class="tpr-timeline__item--orange"</code> to the <code>tpr-timeline-item</code> element.</li>
                            <li>Red - you can set this by adding <code>class="tpr-timeline__item--red"</code> to the <code>tpr-timeline-item</code> element.</li>
                    </ul>
                </p>
                <p class="govuk-body">These colours are defined within the page. They are applied by adding <code>class="tpr-timeline__item--whatever3"</code> to the <code>tpr-timeline-item</code> element. Therefore consuming applications can control the line colour for each item in the timeline.</p>
<code>
    .tpr-timeline__item--whatever3,<br/>
    .tpr-timeline__item--whatever3::before,<br/>
    .tpr-timeline__item--whatever3:last-of-type::after<br/>
    {<br/>
        &nbsp;&nbsp;&nbsp;border-color: #7466be;<br/>
    }<br/>
</code>
                </tpr-timeline-item-content>
            </tpr-timeline-item>
            <tpr-timeline-item date="Custom colour 4"  class="tpr-timeline__item--whatever4">
            </tpr-timeline-item>
            <tpr-timeline-item date="Custom colour 5"  class="tpr-timeline__item--whatever5">
            </tpr-timeline-item>
            <tpr-timeline-item date="Orange"  class="tpr-timeline__item--orange">
            </tpr-timeline-item>
            <tpr-timeline-item date="Red"  class="tpr-timeline__item--red">
            </tpr-timeline-item>
        </tpr-timeline>
    </div>
</div>
}
else
{
    <partial name="GOVUK/BlockList" model="Model.GovukBlocks" />
}