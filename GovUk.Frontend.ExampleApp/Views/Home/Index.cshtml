@section Back {}
@{
    ViewData["Title"] = "Home";
}

<span class="govuk-caption-xl">Example application</span>
<div class="govuk-grid-row govuk-grid-row--tpr-divider">
    <div class="govuk-grid-column govuk-grid-column-full">
        <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
    </div>
</div>

<p class="govuk-body">This example application demonstrates GOV.UK Design System components and styling. By default an extra layer of styling is applied to demonstrate the brand of The Pensions Regulator (TPR), but this can be switched off in appsettings.json to return to GOV.UK styling.</p>
<p class="govuk-body"><a class="govuk-link" href="/typography">Typography</a> is based on GOV.UK Frontend, with a layer of styling for TPR.</p>
<p class="govuk-body">The following GOV.UK Design System components are implemented:</p>
<ul class="govuk-list govuk-list--bullet">
    <li><a class="govuk-link" href="/accordion">accordion</a></li>
    <li>back to top (<a class="govuk-link" href="https://github.com/alphagov/govuk-design-system-backlog/issues/5">proposed for the GOV.UK Design System</a>, implemented to a TPR design on every page)</li>
    <li><a class="govuk-link" href="/button">button</a></li>
    <li><a class="govuk-link" href="/checkboxes">checkboxes</a></li>
    <li><a class="govuk-link" href="/customvalidation">custom validation</a></li>
    <li><a class="govuk-link" href="/dateinput">date input</a></li>
    <li><a class="govuk-link" href="/details">details</a></li>
    <li><a class="govuk-link" href="/fileupload">file upload</a></li>
    <li><a class="govuk-link" href="/insettext">inset text</a></li>
    <li><a class="govuk-link" href="/notificationbanner">notification banner</a></li>
    <li><a class="govuk-link" href="/pagination">pagination</a></li>
    <li><a class="govuk-link" href="/panel">panel</a></li>
    <li><a class="govuk-link" href="https://design-system.service.gov.uk/components/phase-banner/">phase banner</a></li>
    <li><a class="govuk-link" href="/radios">radios</a></li>
    <li><a class="govuk-link" href="/select">select</a></li>
    <li><a class="govuk-link" href="/summarycard">summary card</a></li>
    <li><a class="govuk-link" href="/summarylist">summary list</a></li>
    <li><a class="govuk-link" href="/tasklist">task list</a></li>
    <li><a class="govuk-link" href="/textarea">textarea</a></li>
    <li><a class="govuk-link" href="/textinput">text input</a> (demonstrates localisation)</li>
    <li><a class="govuk-link" href="/warningtext">warning text</a></li>
</ul>

<p class="govuk-body">This example application also includes some TPR brand components:</p>

<ul class="govuk-list govuk-list--bullet">
    <li><a href="/dividerlinesandboxes" class="govuk-link">divider lines and boxes</a></li>
    <li><a class="govuk-link" href="/relatedlinks">related links</a></li>
    <li><a class="govuk-link" href="/sectioncards">section cards</a></li>
    <li><a class="govuk-link" href="/youtubevideo">YouTube video</a></li>
</ul>
