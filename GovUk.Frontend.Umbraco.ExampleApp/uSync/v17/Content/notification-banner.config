            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp class=\u0022govuk-body\u0022\u003EAvoid showing more than one notification banner on the same page. Instead, combine the messages in a single notification banner. If the messages are too different to combine, only show the highest priority notification banner.\u003C/p\u003E\n\u003Cp class=\u0022govuk-body\u0022\u003ESee\u00A0\u003Ca href=\u0022https://design-system.service.gov.uk/components/notification-banner/\u0022 class=\u0022govuk-link\u0022\u003Enotification banner\u003C/a\u003E\u00A0for more guidance.\u003C/p\u003E"
          }
        }
      ]
    },
