              "Layout": {}
            },
            "markup": "\u003Cp\u003EA\u003Cspan\u003E\u00A0\u003C/span\u003E\u003Ca href=\u0022https://design-system.service.gov.uk/components/notification-banner/\u0022 class=\u0022govuk-notification-banner__link\u0022\u003Enotification banner\u003C/a\u003E\u003Cspan\u003E lets you tell the user about something that\u0027s not directly relevant to the thing they\u2019re trying to do on that page of the service.\u003C/span\u003E\u003Cspan\u003E\u003C/span\u003E\u003C/p\u003E"
          }
        },
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: left;\u0022 class=\u0022custom-class\u0022\u003EYou can apply a custom class.\u003C/p\u003E\n\u003Cp\u003EButtons can be targeted with JavaScript to add additional functionality. If JavaScript is not available, the button should be hidden. To achieve this apply the \u0027govuk-!-display-none\u0027 class to the button and remove it with JavaScript.\u003C/p\u003E"
          }
        }
      ]
