@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using ThePensionsRegulator.Frontend.Models
@model TprSessionTimeOutModel
@{
    var id = string.IsNullOrWhiteSpace(Model.Id)
        ? $"tpr-session-timeout-{Guid.NewGuid():N}"
        : Model.Id;
    var titleId = $"{id}-title";
    var descriptionId = $"{id}-description";
    var errorId = $"{id}-error";
    var hasSecondaryAction = Model.DisplaySecondaryAction
        && !string.IsNullOrWhiteSpace(Model.SecondaryActionText)
        && !string.IsNullOrWhiteSpace(Model.SecondaryActionUrl);
}
<dialog id="@id"
        class="tpr-session-timeout-warning@(Model.RenderInline ? " tpr-session-timeout-warning--inline" : string.Empty)"
        role="@(Model.RenderInline ? "dialog" : "alertdialog")"
        aria-labelledby="@titleId"
        aria-describedby="@descriptionId @errorId"
        open="@Model.RenderInline"
        data-tpr-session-timeout="@(Model.RenderInline ? null : "true")">
    <h2 id="@titleId" class="govuk-heading-m" tabindex="-1">@Model.Title</h2>
    <div id="@descriptionId" class="govuk-body">
        @if (Model.ContentHtml is not null)
        {
            @Model.ContentHtml
        }
        else if (!string.IsNullOrWhiteSpace(Model.Content))
        {
            <p>@Model.Content</p>
        }
    </div>

    <p id="@errorId" class="govuk-error-message" role="alert" hidden></p>

    @if (Model.DisplayPrimaryAction && !string.IsNullOrWhiteSpace(Model.PrimaryActionText))
    {
        <button type="button"
                class="govuk-button"
                data-module="govuk-button"
                data-session-timeout-primary
                data-session-extend-url="@Model.PrimaryActionUrl">
            @Model.PrimaryActionText
        </button>
    }

    @if (hasSecondaryAction)
    {
        <div>
            <a class="govuk-link" href="@Model.SecondaryActionUrl">@Model.SecondaryActionText</a>
        </div>
    }
</dialog>
