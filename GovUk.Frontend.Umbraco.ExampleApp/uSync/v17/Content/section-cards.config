    {
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "key": "252b65a4-fe31-4f22-88d0-74b0892abb0e",
      "udi": null,
      "values": [
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Example application in Umbraco"
        }
      ]
    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
      "key": "35509ae8-5a8b-47f8-8b1c-ffc9d3923616",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "3e7f714e-3c98-4b6d-a471-5531d7df22a1",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe section cards component displays a list of cards which can be added manually or generated automatically from child pages.\u003C/p\u003E\n\u003Cp\u003EThe second child page is missing from the generated cards because it has the\u0026nbsp;\u003Cem\u003EumbracoNaviHide\u003C/em\u003E\u0026nbsp;property set to true, which hides it from navigation.\u003C/p\u003E\n\u003Cp\u003ESection cards are normally added inside a \u0027Box\u0027 or \u0027Nested box\u0027 block. If a \u0027Box\u0027 or \u0027Nested box\u0027 block is not used there must still be a coloured background so that the individual cards stand out. When used inside a \u0027Box\u0027 or \u0027Nested box\u0027 this background must be removed.\u003C/p\u003E\n\u003Cp\u003EThe end result should be that section cards look exactly the same whether they are inside a \u0027Box\u0027 or \u0027Nested box\u0027 with default settings or not, but using a \u0027Box\u0027 or \u0027Nested box\u0027 adds the flexibility to use other settings like breaking out of the width container or changing the background colour.\u003C/p\u003E\n\u003Cp\u003EThe number of section cards on a row should adapt to the size of the browser viewport.\u003C/p\u003E\n\u003Ch2 class=\u0022govuk-heading-m\u0022\u003EBreak out of the width container\u003C/h2\u003E\n\u003Cp\u003EThe first two examples show section cards inside a \u0027Box\u0027 block that has its style set to \u0027Full-width\u0027, to break out of the width container. This is the most common usage. There are two examples in order to show that section cards respect different background colour settings on the \u0027Box\u0027.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "066d1a32-459b-4a94-9fff-3295f9eb25eb",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe next example shows section cards inside a \u0027Full width\u0027 layout block, but not using a \u0027Nested box\u0027.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "0b5739c4-7a23-477c-b1ef-e975b35c6d49",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe next example shows section cards inside a \u0027Box\u0027 which is at the block grid root.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "d15c5f7a-2479-4eea-bcf6-4ce8901d1e1c",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe next example shows a section cards block at the root of the block grid, but with no cards configured. It should not render anything.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "2cbb6784-7af0-4c10-b7b1-e63271e689b6",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe next example shows section cards in a \u0027Box\u0027 which is added at the block grid root, with its style set to \u0027Bordered\u0027.\u003C/p\u003E"
          }
        }
      ]
    },
