      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "text": {
        "markup": "<table><caption>Table caption</caption>\n<thead>\n<tr>\n<th scope=\"col\">Column header 1</th>\n<th scope=\"col\">Column header 2</th>\n<th scope=\"col\">Column header 3</th>\n<th class=\"govuk-table__header--numeric\" scope=\"col\">Numeric data</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<th scope=\"row\">Row header 1</th>\n<td>Data cell 1</td>\n<td>Data cell 2</td>\n<td class=\"govuk-table__cell--numeric\">1</td>\n</tr>\n<tr>\n<th scope=\"row\">Row header 2</th>\n<td>Data cell 3</td>\n<td>Data cell 4</td>\n<td class=\"govuk-table__cell--numeric\">2</td>\n</tr>\n<tr>\n<th scope=\"row\">Row header 3</th>\n<td>Data cell 5</td>\n<td>Data cell 6</td>\n<td class=\"govuk-table__cell--numeric\">3</td>\n</tr>\n</tbody>\n</table>\n<p>The CSV download button above is automatically added below every table in block grid or block list content provided<span>&nbsp;</span><strong>EnableTableCsvDownload&nbsp;</strong>is set to true in<strong>&nbsp;TprFrontendOptions</strong>; this is for improved accessibility.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/be6663c62db641b2bb8f388c0edb5161"
    },
