@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<OverridableBlockGridItem>;
@addTagHelper *, ThePensionsRegulator.Frontend
@using GovUk.Frontend.Umbraco.Models
@using GovUk.Frontend.Umbraco;
@using ThePensionsRegulator.Umbraco.Blocks;
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@using Umbraco.Cms.Web.Common.PublishedModels
@using GovUkPropertyAliases = GovUk.Frontend.Umbraco.PropertyAliases
@using TprPropertyAliases = ThePensionsRegulator.Frontend.Umbraco.PropertyAliases;
@using ElementTypeAliases = ThePensionsRegulator.Frontend.Umbraco.ElementTypeAliases;
@{
    var boxes = Model.Content.Value<OverridableBlockListModel>(TprPropertyAliases.TprBoxedSectionBoxes);
    if (boxes == null || boxes.Any() == false)
    {
        return;
    }
    var settings = Model.Settings;
    var nameFieldName = string.Empty;
    var descFieldName = string.Empty;

    if(settings != null){
        nameFieldName = settings.Value<string>("titleFieldName");
        descFieldName = settings.Value<string>("descriptionFieldName");        
    }

    if (string.IsNullOrWhiteSpace(nameFieldName))
    {
        nameFieldName = "name";
    }

    if (string.IsNullOrWhiteSpace(descFieldName))
    {
        descFieldName = "description";
    }

    var cssClasses = (" " + Model.Settings.Value<string>(GovUkPropertyAliases.CssClasses)).TrimEnd();

    <ul class="tpr-boxedsection-container govuk-body @cssClasses">

        @foreach (var box in boxes)
        {


            var type = box.Content.ContentType.Alias;
            switch (type)
            {
                case ElementTypeAliases.TprBoxedSectionCard:
                    var link = box.Content.Value<Link>("link");
                    var name = link.Name;
                    var url = link.Url;
                    var desc = box.Content.Value<string>(descFieldName);
                    <li class="tpr-boxedsection">
                        <div class="tpr-boxedsection-body">
                            <h2 class="tpr-boxedsection-title">
                                <a class="govuk-link" href="@url">@name</a>
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(desc))
                            {
                                <p>@desc</p>
                            }
                        </div>
                    </li>
                    break;
                case ElementTypeAliases.TprBoxedSectionChildren:
                    var page = Umbraco.AssignedContentItem;
                    foreach (var child in page.Children)
                    {
                        if (!child.IsVisible())
                        {
                            continue;
                        }
                        var childName = child.Name;
                        if(nameFieldName != "name")
                        {
                            childName = child.Value<string>(nameFieldName);
                        }
                        var childUrl = child.Url();
                        var childDesc = child.Value<string>(descFieldName);
                        <li class="tpr-boxedsection">
                            <div class="tpr-boxedsection-body">
                                <h2 class="tpr-boxedsection-title">
                                    <a class="govuk-link" href="@childUrl">@childName</a>
                                </h2>
                                @if (!string.IsNullOrWhiteSpace(childDesc))
                                {
                                    <p>@childDesc</p>
                                }
                            </div>
                        </li>
                    }
                    break;
            }
        }

    </ul>
}