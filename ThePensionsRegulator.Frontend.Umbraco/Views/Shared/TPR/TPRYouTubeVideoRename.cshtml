@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IOverridableBlockReference<IOverridablePublishedElement, IOverridablePublishedElement>>;
@addTagHelper *, ThePensionsRegulator.Frontend
@using GovUk.Frontend.Umbraco.Models
@using GovUk.Frontend.Umbraco;
@using ThePensionsRegulator.Umbraco.Blocks;
@using ThePensionsRegulator.Umbraco;
@using Umbraco.Cms.Core.Models
@using Umbraco.Extensions
@using Umbraco.Cms.Web.Common.PublishedModels
@using GovUkPropertyAliases = GovUk.Frontend.Umbraco.PropertyAliases
@using TprPropertyAliases = ThePensionsRegulator.Frontend.Umbraco.PropertyAliases;
@using ElementTypeAliases = ThePensionsRegulator.Frontend.Umbraco.ElementTypeAliases;


@{
    @* Since we cannot make AblePlayer work with the existing 
    security headers, we have hardcoded the following condition to be false
    and therefore the default YouTube embed iFrame is always used. In order to
    reverse this, change the useAblePlayer to true and uncomment the block 
    directly below it. *@
    var useAblePlayer = false;
    @* // Make it readable by keeping it on separate lines
    if(!Context.Request.Cookies.TryGetValue("TPR_Cookie_CONSENT", out string? cookieValue) || cookieValue == "Reject")
    {
        useAblePlayer = false;
    } *@
    var videoUrl = Model.Content.Value<string>("url");
    if(string.IsNullOrWhiteSpace(videoUrl))
    {
        return;
    }
    string id = Model.Content.Key.ToString();
    var title = Model.Content.Value<string>("title");
    var urlToken = "v=";
    var videoId = videoUrl.Substring(videoUrl.IndexOf(urlToken) + urlToken.Length);
    var transcriptLink = Model.Content.Value<Link>("transcriptUrl");
    var transcriptUrl = string.Empty;
    var transcriptTitle = "View the script for this video";
    var transcriptTarget = string.Empty;
    if (!string.IsNullOrWhiteSpace(transcriptLink?.Url))
    {
        transcriptUrl = transcriptLink.Url;
        transcriptTarget = transcriptLink.Target;
    }
    if (!string.IsNullOrWhiteSpace(transcriptLink?.Name))
    {
        transcriptTitle = transcriptLink.Name;
    }

    var autoplay = Model.Settings.Value<bool>("autoplay");
    
    bool playsInline = Model.Settings.Value<bool>("playsInline")!;
    string preload = Model?.Settings?.Value<string>("preload")!;
    if(string.IsNullOrWhiteSpace(preload)){
        preload = "metadata";
    }
}
<tpr-youtube-video
    id="@id" 
    title="@title"
    videoId="@videoId"
    useAblePlayer="@useAblePlayer"
    preload="@preload"
    autoplay="@autoplay"
    playsinline="@playsInline"
    transcriptUrl="@transcriptUrl"
    transcriptTitle="@transcriptTitle"
    transcriptTarget="@transcriptTarget"
    >
</tpr-youtube-video>