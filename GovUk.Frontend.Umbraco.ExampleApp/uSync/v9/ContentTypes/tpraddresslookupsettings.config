  <Info>
    <Name>Address lookup settings</Name>
    <Icon>icon-circus color-black</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>Settings for a TPR component to lookup an address. If JavaScript is unavailable, text inputs are shown for mannual entry.</Description>
