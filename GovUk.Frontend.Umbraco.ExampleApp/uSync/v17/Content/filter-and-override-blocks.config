      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "key": "dc035316-614d-4ae6-8aea-2da054cf5234",
      "udi": null,
      "values": [
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Example application in Umbraco"
        }
      ]
    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
      "key": "d2e16cbc-9302-41b3-a7bc-c5ec6f9b4867",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "e60b4f17-fe50-49ae-a439-51c9255d6410",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp class=\u0022govuk-heading-m govuk-body\u0022\u003EYou can filter and override block list and block grid items from code in the controller for the document type. See \u003Ca href=\u0022https://our.umbraco.com/documentation/reference/routing/custom-controllers\u0022\u003EUmbraco custom controllers\u003C/a\u003E and the code for \u003Cem\u003EFilterAndOverrideBlocksController.cs\u003C/em\u003E in this project.\u003C/p\u003E\n\u003Ch2 class=\u0022govuk-heading-m\u0022\u003EFilter block list items\u003C/h2\u003E\n\u003Cp\u003EThis is the first item. The second one should be removed by a filter which is defined in the controller.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "c12234d2-e034-4bb7-a4c3-2c5ddf2a7295",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis is the second item. It should be removed by a filter which is defined in the controller.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "af8c642b-39ab-4e82-ae82-f9af7b7ae1cf",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Ch2 class=\u0022govuk-heading-m\u0022\u003EOverride block list items\u003C/h2\u003E\n\u003Cp\u003EThe properties of block list items can be overridden from the controller. The next paragraph says \u0022This is the original text.\u0022 in the back office, but should be displayed as \u0022This text is overridden.\u0022\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "0e33e52e-00d3-4546-af2b-076321ead08a",
      "key": "4a22682f-c433-472a-b093-b22f4f378c4d",
      "udi": null,
      "values": [
        {
          "alias": "blocks",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "contentData": [
              {
                "contentTypeKey": "e8386da2-bf9c-43e2-ac0e-02f33f6b6c2d",
                "key": "906435b3-d642-4f0f-943a-d02d1993d8ea",
                "udi": null,
                "values": [
                  {
                    "alias": "blocks",
                    "culture": null,
                    "editorAlias": null,
                    "segment": null,
                    "value": {
                      "contentData": [
                        {
                          "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
                          "key": "9c7994ba-a2b2-4d34-a633-2a94df569083",
                          "udi": null,
                          "values": [
                            {
                              "alias": "text",
                              "culture": null,
                              "editorAlias": null,
                              "segment": null,
                              "value": {
                                "blocks": {
