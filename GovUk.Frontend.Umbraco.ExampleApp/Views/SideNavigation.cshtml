@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.SideNavigation>
@using ThePensionsRegulator.Umbraco
@using Umbraco.Cms.Web.Common.PublishedModels;
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Microsoft.Extensions.Configuration;
@inject IConfiguration Configuration
@{
    var useTPRstyles = Configuration.GetValue<bool>("TPRStyles");
}
@section head {
	<title>@Model.PageHeadingOrName()</title>
}

@if (useTPRstyles)
{
	<partial name="GOVUK/BlockGrid" model="Model.Grid" />
}
else
{
	<partial name="GOVUK/BlockList" model="Model.GovukBlocks" />
}