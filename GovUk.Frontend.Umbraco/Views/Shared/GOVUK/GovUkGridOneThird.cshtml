@using GovUk.Frontend.Umbraco;
@using ThePensionsRegulator.Umbraco.Blocks;
@using Umbraco.Cms.Core.Models.Blocks;
@using Umbraco.Cms.Core.Models.PublishedContent;
@using Umbraco.Extensions
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<OverridableBlockGridItem>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@if (Model.Areas is not null && Model.Areas.Any())
{
    var breakpointClass = Model.Settings.Value<string>(PropertyAliases.StackColumns) == "Mobile and tablet" ? "-from-desktop" : string.Empty;
    var rowClasses = $"{HtmlClassNames.Row} {Model.Settings.Value<string>(PropertyAliases.CssClassesForRow)}".TrimEnd();
    <div class="@rowClasses">
        <div class="@HtmlClassNames.Column @HtmlClassNames.ColumnOneThird@(breakpointClass)">
            <partial name="GOVUK/BlockGrid" model="Model.Areas[0]" />
        </div>
    </div>
}