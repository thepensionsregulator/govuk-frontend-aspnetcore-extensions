      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EUse the \u003Ca href=\u0022https://design-system.service.gov.uk/components/inset-text/\u0022\u003Einset text\u003C/a\u003E component to differentiate a block of text from the content that surrounds it.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "key": "d0fb3de2-fbf3-4c76-b0dc-e9e80cdcf952",
      "udi": null,
      "values": [
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Example application in Umbraco"
        }
      ]
    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
      "key": "d788e6b0-9312-4b7b-8548-fee0a6808d2d",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "40bb2a3e-3d75-4ec1-9134-e0c46c6f04a0",
      "key": "223e6dec-830f-474b-b4cd-2938036b6e0e",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp class=\u0022custom-class\u0022\u003EWhen there is a single paragraph with no class applied, the surrounding \u003Cstrong\u003Ep \u003C/strong\u003Eelement should be removed. This inset text component has just one paragraph but a custom class is applied, so the\u0026nbsp;\u003Cstrong\u003Ep\u003C/strong\u003E element should be kept.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "40bb2a3e-3d75-4ec1-9134-e0c46c6f04a0",
      "key": "92987d19-fcb7-41d7-8efd-b932f81617ca",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp class=\u0022govuk-body\u0022\u003EInset text components can (although rarely should) contain multiple paragraphs.\u003C/p\u003E\n\u003Cp class=\u0022custom-class\u0022\u003ECustom classes can be applied when there are multiple paragraphs.\u003C/p\u003E"
          }
        }
      ]
    }
  ],
