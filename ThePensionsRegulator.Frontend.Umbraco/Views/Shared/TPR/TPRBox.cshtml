@using GovUk.Frontend.Umbraco;
@using ThePensionsRegulator.Umbraco.Blocks;
@using Umbraco.Cms.Core.Models.Blocks;
@using Umbraco.Cms.Core.Models.PublishedContent;
@using TprPropertyAliases = ThePensionsRegulator.Frontend.Umbraco.PropertyAliases
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<OverridableBlockGridItem>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@if (Model.Areas is not null && Model.Areas.Any())
{
    var styleOfBox = Model.Settings.Value<string>(TprPropertyAliases.TprBoxStyle);
    var boxClass = (string.IsNullOrEmpty(styleOfBox) || styleOfBox == "Solid box") ? null : " tpr-box--" + styleOfBox.ToLowerInvariant().Replace(" box", string.Empty);
    var cssClasses = (" " + Model.Settings.Value<string>(PropertyAliases.CssClasses)).TrimEnd();
    <div class="tpr-box@(boxClass)@(cssClasses)">
        <partial name="GOVUK/BlockGrid" model="Model.Areas[0]" />
    </div>
}