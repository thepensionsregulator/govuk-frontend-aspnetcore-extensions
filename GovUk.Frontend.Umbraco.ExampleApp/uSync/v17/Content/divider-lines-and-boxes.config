      "key": "704aa73f-941b-4903-9e02-09e167df6058",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis is the same example, except that the columns remain stacked at the tablet breakpoint.\u003C/p\u003E"
          }
        }
      ]
    },
