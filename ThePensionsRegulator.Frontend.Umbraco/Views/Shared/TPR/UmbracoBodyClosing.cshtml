@using GovUk.Frontend.Umbraco
@using Microsoft.Extensions.Options
@inject IOptions<GovUkFrontendUmbracoOptions> govUkUmbracoOptions
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Smidge
<environment names="Development">
    <script src="tpr-frontend-js" type="module" debug="true"></script>
</environment>
<environment names="Staging,Production">
    <script src="tpr-frontend-js" type="module"></script>
</environment>
@if (govUkUmbracoOptions.Value.EnableTableCsvDownload)
{
    <environment names="Development">
        <script src="govuk-table-csv-download" debug="true"></script>
    </environment>
    <environment names="Staging,Production">
        <script src="govuk-table-csv-download"></script>
    </environment>
}