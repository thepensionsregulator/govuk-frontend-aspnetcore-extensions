@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Web.Common
@using GovUkPropertyAliases = GovUk.Frontend.Umbraco.PropertyAliases
@using TprPropertyAliases = ThePensionsRegulator.Frontend.Umbraco.PropertyAliases
@addTagHelper *, ThePensionsRegulator.Frontend

@{
    var OuterCssClasses = Model.Settings.Value<string>(GovUkPropertyAliases.CssClasses);
    var documents = Model.Content.Value<IEnumerable<BlockListItem>>(TprPropertyAliases.TprDocumentsBlockList);
}

<tpr-documents class="@OuterCssClasses">

    @foreach (var document in documents)
    {
        var innerCssClasses = document.Settings.Value<string>(GovUkPropertyAliases.CssClasses);
        var docLinkType = document.Content.Value<Link>(TprPropertyAliases.TprDocument).Type;
        var docTitle = document.Content.Value<Link>(TprPropertyAliases.TprDocument).Name;
        var docDatePublished = document.Content.Value<string>(TprPropertyAliases.TprDocumentDatePublished);
        var docDescription = document.Content.Value<string>(TprPropertyAliases.TprDocumentDescription);

        if (docLinkType == LinkType.Media)
        {
            var docHref = document.Content.Value<Link>(TprPropertyAliases.TprDocument).MediaUrl;
            var docKB = document.Content.Value<Link>(TprPropertyAliases.TprDocument).GetPropertyValue<int>("umbracoBytes");
            var docPages = document.Content.Value<string>(TprPropertyAliases.TprDocumentNumberOfPages);

            <tpr-document href="@docHref" kbsize="@docKB" pages="@docPages" class="@innerCssClasses">

                <tpr-document-title>@docTitle</tpr-document-title>

                <dd>Published: @docDatePublished</dd>

                <tpr-document-description>@docDescription</tpr-document-description>

            </tpr-document>
        }
        else
        {
            var docHref = document.Content.Value<Link>(TprPropertyAliases.TprDocument).Url;

            <tpr-document href="@docHref" class="@innerCssClasses">

                <tpr-document-title>@docTitle</tpr-document-title>

                <dd>Published: @docDatePublished</dd>

                <tpr-document-description>@docDescription</tpr-document-description>

            </tpr-document>
        }
    }

</tpr-documents>