      "values": [
        {
          "alias": "caption",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Example application in Umbraco"
        }
      ]
    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
      "key": "d90d68fe-127b-4bda-a6fe-078749012519",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "e03a43c5-dd09-412c-8ed1-b65fa2e8d226",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EImages are supported when using the \u0027TPR block grid\u0027 or \u0027TPR block list\u0027 data types.\u003C/p\u003E\n\u003Cp\u003EBy default images are resized to fit the width of their container, to support responsive design.\u00A0\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "c97034b1-1083-47b0-8911-c5c8ef97ea21",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EImages can be set to retain their original size. This is useful for smaller images that lose quality when scaled up.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "2f253f6e-1266-49a8-864c-44eca0c6cab7",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EImages have the same spacing after that is used by all components. However, images have the option to switch this off so that they can be placed together.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "9389c5e5-ce97-4211-97c5-f2cd173ca648",
      "key": "7e77ba10-baf8-482a-b0cd-4d92f4ce8af9",
