@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<IOverridableBlockReference<IOverridablePublishedElement,IOverridablePublishedElement>>;
@addTagHelper *, ThePensionsRegulator.Frontend
@using System.Web;
@using ThePensionsRegulator.GovUk.Frontend.Umbraco;
@using ThePensionsRegulator.GovUk.Frontend.Umbraco.Models
@using GovUkPropertyAliases = ThePensionsRegulator.GovUk.Frontend.Umbraco.PropertyAliases
@using Microsoft.AspNetCore.Html
@using ThePensionsRegulator.Frontend.TagHelpers
@using ThePensionsRegulator.Frontend.Umbraco
@using ThePensionsRegulator.Umbraco.Core
@using ThePensionsRegulator.Umbraco.Core.Blocks
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Extensions
@{
    var cards = Model.Content.Value<OverridableBlockListModel>(TprPropertyAliases.SectionCards);
    if (cards == null || cards.Any() == false)
    {
        return;
    }

    var nameFieldName = Model.Settings?.Value<string>(TprPropertyAliases.SectionCardNameProperty);
    var descFieldName = Model.Settings?.Value<string>(TprPropertyAliases.SectionCardDescriptionProperty);
    if (string.IsNullOrWhiteSpace(descFieldName))
    {
        descFieldName = TprPropertyAliases.SectionCardDescriptionPropertyDefault;
    }

    var cssClasses = Model.Settings?.Value<string>(GovUkPropertyAliases.CssClasses);

    var headingClass = Model.Settings?.Value<string?>(TprPropertyAliases.SectionCardsTitleHeadingClass);
    if (string.IsNullOrEmpty(headingClass))
    {
        headingClass = "govuk-heading-m";
    }

    string headingLevelProperty = Model.Settings?.Value<string>(TprPropertyAliases.SectionCardsTitleHeadingLevel) ?? string.Empty;
    var headingLevel = headingLevelProperty.Replace("heading ", string.Empty, System.StringComparison.OrdinalIgnoreCase)?.Trim();
    if (!int.TryParse(headingLevel, out int numericHeadingLevel))
    {
        numericHeadingLevel = 2;
    }

    string navigationAriaLabel = Model.Settings?.Value<string>(TprPropertyAliases.SectionCardsNavigationAriaLabel) ?? string.Empty;

    <tpr-section-cards class="@cssClasses" new-tab-text="@Umbraco.GetDictionaryValueOrDefault(DictionaryConstants.OpensInNewTab, DictionaryConstants.OpensInNewTab)" card-titles-heading-level="@numericHeadingLevel" card-titles-heading-class="@headingClass" navigation-aria-label="@navigationAriaLabel">
        @foreach (var card in cards)
        {           
            var type = card.Content.ContentType.Alias;
            var cardClass = card.Settings?.Value<string>(GovUkPropertyAliases.CssClasses);
            switch (type)
            {
                case TprElementTypeAliases.SectionCard:
                    var link = card.Content.Value<Link>(TprPropertyAliases.SectionCardLink);
                    if (link == null) { continue; }
                    var name = link.Name;
                    var url = link.Url;
                    var target = link.Target;
                    var desc = card.Content.Value<string>(descFieldName);
                    <tpr-section-card class="@cardClass">                       
                        <tpr-section-card-title href="@url" target="@target" allow-html="true">
                                @name 
                        </tpr-section-card-title>
                        @if (!string.IsNullOrWhiteSpace(desc))
                        {
                            <tpr-section-card-content allow-html="true">@Html.Raw(@desc)</tpr-section-card-content>
                        }
                    </tpr-section-card>
                    break;
                case TprElementTypeAliases.SectionCardsForChildPages:
                    var page = Umbraco.AssignedContentItem;
                    foreach (var child in page.Children())
                    {
                        if (!child.IsVisible())
                        {
                            continue;
                        }
                        var childName = child.Name;
                        if (!string.IsNullOrWhiteSpace(nameFieldName))
                        {
                            childName = child.Value<string>(nameFieldName);
                        }
                        var childUrl = child.Url();
                        var childDesc = HttpUtility.HtmlDecode(child.Value<string>(descFieldName));
                        <tpr-section-card class="@cardClass">
                            <tpr-section-card-title href="@childUrl" allow-html="true">
                                @Html.Raw(childName)
                            </tpr-section-card-title>
                            @if (!string.IsNullOrWhiteSpace(childDesc))
                            {
                                <tpr-section-card-content allow-html="true">@Html.Raw(childDesc)</tpr-section-card-content>
                            }
                        </tpr-section-card>
                    }
                    break;
            }
        }
    </tpr-section-cards>   
}
