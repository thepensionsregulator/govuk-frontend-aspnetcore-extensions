@model AddressLookupViewModel
@inject ITprAddressLookupEndpointUrlProvider urlProvider

<h3 class="govuk-heading-m">Shipping address</h3>
<p class="govuk-body">Tell us where you would like your order shipped to.</p>

<tpr-address-lookup role="Primary"
                    data-address-lookup-search-url=@urlProvider.GetAddressLookupSearchEndpoint()
                    data-address-lookup-id-url=@urlProvider.GetAddressLookupIdEndpoint()>
    <tpr-address-lookup-legend>Shipping address</tpr-address-lookup-legend>

    <govuk-client-side-validation error-message-required="This field is required"
                                  error-message-maxlength="Cannot exceed the maximum length">
        <govuk-input for="ShippingAddressLine1" autocomplete="address-line1"
                     input-attributes="@(new Dictionary<string, string?>{{"data-address-lookup", "address-line-1"}})">
            <govuk-input-label>Address line 1</govuk-input-label>
            @if (ViewContext.ModelState.ContainsKey("ShippingAddressLine1") && ViewContext.ModelState["ShippingAddressLine1"]!.Errors.Count > 0)
            {
                <govuk-input-error-message>@ViewContext.ModelState["ShippingAddressLine1"]!.Errors[0].ErrorMessage</govuk-input-error-message>
            }
        </govuk-input>
    </govuk-client-side-validation>

    <govuk-client-side-validation error-message-maxlength="Cannot exceed the maximum length">
        <govuk-input for="ShippingAddressLine2" autocomplete="address-line2"
                     input-attributes="@(new Dictionary<string, string?>{{"data-address-lookup", "address-line-2"}})">
            <govuk-input-label>Address line 2 (optional)</govuk-input-label>
            @if (ViewContext.ModelState.ContainsKey("ShippingAddressLine2") && ViewContext.ModelState["ShippingAddressLine2"]!.Errors.Count > 0)
            {
                <govuk-input-error-message>@ViewContext.ModelState["ShippingAddressLine2"]!.Errors[0].ErrorMessage</govuk-input-error-message>
            }
        </govuk-input>
    </govuk-client-side-validation>

    <govuk-client-side-validation error-message-required="This field is required"
                                  error-message-maxlength="Cannot exceed the maximum length">
        <govuk-input for="ShippingTownOrCity" input-class="govuk-input--width-20" autocomplete="address-level2"
                     input-attributes="@(new Dictionary<string, string?>{{"data-address-lookup", "town-or-city"}})">
            <govuk-input-label>Town or city</govuk-input-label>
            @if (ViewContext.ModelState.ContainsKey("ShippingTownOrCity") && ViewContext.ModelState["ShippingTownOrCity"]!.Errors.Count > 0)
            {
                <govuk-input-error-message>@ViewContext.ModelState["ShippingTownOrCity"]!.Errors[0].ErrorMessage</govuk-input-error-message>
            }
        </govuk-input>
    </govuk-client-side-validation>

    <govuk-client-side-validation error-message-maxlength="Cannot exceed the maximum length">
        <govuk-input for="ShippingCounty" input-class="govuk-input--width-20" autocomplete="address-level3"
                     input-attributes="@(new Dictionary<string, string?>{{"data-address-lookup", "county"}})">
            <govuk-input-label>County (optional)</govuk-input-label>
            @if (ViewContext.ModelState.ContainsKey("ShippingCounty") && ViewContext.ModelState["ShippingCounty"]!.Errors.Count > 0)
            {
                <govuk-input-error-message>@ViewContext.ModelState["ShippingCounty"]!.Errors[0].ErrorMessage</govuk-input-error-message>
            }
        </govuk-input>
    </govuk-client-side-validation>

    <govuk-client-side-validation error-message-required="This field is required">
        <govuk-input for="ShippingCountry" input-class="govuk-input--width-20" autocomplete="country"
                     input-attributes="@(new Dictionary<string, string?>{{"data-address-lookup", "country"}})">
            <govuk-input-label>Country</govuk-input-label>
            @if (ViewContext.ModelState.ContainsKey("ShippingCountry") && ViewContext.ModelState["ShippingCountry"]!.Errors.Count > 0)
            {
                <govuk-input-error-message>@ViewContext.ModelState["ShippingCountry"]!.Errors[0].ErrorMessage</govuk-input-error-message>
            }
        </govuk-input>
    </govuk-client-side-validation>

    <govuk-client-side-validation error-message-required="This field is required"
                                  error-message-maxlength="Cannot exceed the maximum length">
        <govuk-input for="ShippingPostcode" input-class="govuk-input--width-10" autocomplete="postal-code"
                     input-attributes="@(new Dictionary<string, string?>{{"data-address-lookup", "postcode"}})">
            <govuk-input-label>Postcode</govuk-input-label>
            @if (ViewContext.ModelState.ContainsKey("ShippingPostcode") && ViewContext.ModelState["ShippingPostcode"]!.Errors.Count > 0)
            {
                <govuk-input-error-message>@ViewContext.ModelState["ShippingPostcode"]!.Errors[0].ErrorMessage</govuk-input-error-message>
            }
        </govuk-input>
    </govuk-client-side-validation>

    <input type="hidden" id="ShippingUPRN" name="ShippingUPRN" value="@Model?.ShippingUPRN" data-address-lookup="UPRN" />
</tpr-address-lookup>

<h3 class="govuk-heading-m">Billing address</h3>
