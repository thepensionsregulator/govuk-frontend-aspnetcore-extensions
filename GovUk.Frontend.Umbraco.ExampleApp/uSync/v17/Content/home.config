    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "ca521a00-28b7-4cdf-939f-a9c310a4fc76",
      "udi": null,
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis text is using \u003Ca href=\u0022https://design-system.service.gov.uk/styles/typography/\u0022\u003EGOV.UK Design System typography\u003C/a\u003E.\u003C/p\u003E\n\u003Cp\u003EThis example application demonstrates GOV.UK Design System components and styling. By default an extra layer of styling is applied to demonstrate the brand of The Pensions Regulator (TPR), but this can be switched off in appsettings.json to return to GOV.UK styling.\u003C/p\u003E\n\u003Cp\u003E\u003Ca href=\u0022/{localLink:8e4e33e6-b5fa-40a2-86cd-7706fcea04ac}\u0022 type=\u0022document\u0022\u003ETypography\u003C/a\u003E\u003Cspan\u003E\u0026nbsp;is based on GOV.UK Frontend, with a layer of styling for TPR.\u003C/span\u003E\u003C/p\u003E\n\u003Cp\u003EThe following GOV.UK Design System components are implemented using the block list and block grid editors in Umbraco:\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:22a4a3ef-d9d7-4129-b573-ea9a707040b3}\u0022 type=\u0022document\u0022\u003Eaccordion\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:49aa9979-672c-4b96-9a1d-a87e0947511d}\u0022 type=\u0022document\u0022\u003Ebreadcrumbs\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:449dad98-8cd8-4579-be6b-e4a5868e4baa}\u0022 type=\u0022document\u0022\u003Ebutton\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:e096f084-c4ae-4ffb-9eef-01e8732eee1c}\u0022 type=\u0022document\u0022\u003Echeckboxes\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:8ec42b5d-d12f-4f47-addc-25aaaeb860dc}\u0022 type=\u0022document\u0022\u003Edate input\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:23619673-13cf-41e2-936e-3c9d0796068a}\u0022 type=\u0022document\u0022\u003Edetails\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:92582581-c190-4c65-be2d-29b8ca4fcf5e}\u0022 type=\u0022document\u0022\u003Eerror message\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:b8342702-1c64-4e21-8f06-dcac3e73f5b5}\u0022 type=\u0022document\u0022\u003Efieldset\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:b1b6e204-f188-4721-a0d0-45c254f54bdd}\u0022 type=\u0022document\u0022\u003Efile upload\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:74f7af6e-c243-4e51-bac3-27d47a1d5687}\u0022 type=\u0022document\u0022\u003Einset text\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:25d7d4f7-b538-4ecb-a526-faa2cdf9f78f}\u0022 type=\u0022document\u0022\u003Egrid\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:cd4111da-0f2a-4401-b0f2-3056f15e6826}\u0022 type=\u0022document\u0022\u003Enotification banner\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:9e647642-8c53-465b-8465-477f5eed307f}\u0022 type=\u0022document\u0022\u003Epagination\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:7ebf39a4-dbdd-454b-92e4-6e544af2a411}\u0022 type=\u0022document\u0022\u003Epanel\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:25fef9b4-ec6f-45ee-bf73-739358d7adcf}\u0022 type=\u0022document\u0022\u003Eradios\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:51d97395-54fb-44aa-be55-b67b4b3f73ba}\u0022 type=\u0022document\u0022\u003Eselect\u003C/a\u003E (demonstrates flexibility within hints)\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:71938c6c-3848-4520-823e-6df35a7e6ac1}\u0022 type=\u0022document\u0022\u003Esummary card\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:b47828f6-93f8-42ba-9544-0618c4774ce8}\u0022 type=\u0022document\u0022\u003Esummary list\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:d92ec734-1e58-4f14-a486-64e04c21cf6f}\u0022 type=\u0022document\u0022\u003Etable\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:27bfc8bb-7566-47e1-8506-c63fb5813f29}\u0022 type=\u0022document\u0022\u003Etask list\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:a8cfa099-8165-4cfe-b3d1-179472290d0c}\u0022 type=\u0022document\u0022\u003Etextarea\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:acbabf45-7b3e-4b53-a825-f7b6185f8840}\u0022 type=\u0022document\u0022\u003Etext input\u003C/a\u003E (demonstrates localisation)\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:0e8a5a37-7a33-41ff-8386-7099db8db229}\u0022 type=\u0022document\u0022\u003Ewarning text\u003C/a\u003E\u003Ca href=\u0022/{localLink:571f9cd8-af6b-4104-96fb-d871cbe58ce3}\u0022 type=\u0022document\u0022\u003E\u003C/a\u003E\u003C/li\u003E\n\u003C/ul\u003E\n\u003Cp\u003EYou can \u003Ca href=\u0022/{localLink:dd8e62c7-3e92-4bf2-8803-ec2d080626e8}\u0022 type=\u0022document\u0022\u003Efilter and override blocks\u003C/a\u003E from code.\u003C/p\u003E\n\u003Cp\u003EOutside of the block list we also implement:\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003E\u003Ca href=\u0022https://design-system.service.gov.uk/components/phase-banner/\u0022\u003Ephase banner\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003Eback to top (\u003Ca href=\u0022https://github.com/alphagov/govuk-design-system-backlog/issues/5\u0022\u003Eproposed for the GOV.UK Design System\u003C/a\u003E, implemented to a TPR design on every page)\u003C/li\u003E\n\u003C/ul\u003E\n\u003Cp\u003EThis example application also includes some TPR brand components:\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003Eback to menu (at the bottom of this page)\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:868203eb-ff42-4739-89ac-d6297ab8bc4a}\u0022 type=\u0022document\u0022\u003Edivider lines and boxes\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:afe8a7fd-d8a8-453e-8313-f6a88449173f}\u0022 type=\u0022document\u0022\u003Edocuments\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:d78b55c9-ae14-414e-805d-5cf4706aab4b}\u0022 type=\u0022document\u0022\u003Efeatured image\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:bd293353-9783-471e-a3a2-38b761102d14}\u0022 type=\u0022document\u0022\u003ETPR header\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:64f019b8-33ef-45b3-9336-3763d189f43d}\u0022 type=\u0022document\u0022\u003ETPR footer\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:b32c5acb-3eb5-4a34-8555-579554021ed4}\u0022 type=\u0022document\u0022\u003Erelated links\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:1612ee2d-35da-401f-99a9-75cb9ad5822d}\u0022 type=\u0022document\u0022\u003Esearch results\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:ba8e8ade-c4f2-4c58-9087-dcc5d79f168d}\u0022 type=\u0022document\u0022\u003Esection cards\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:f3f20d48-8330-4384-9a56-49504200791e}\u0022 type=\u0022document\u0022\u003Eside navigation\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:e2e5d201-b46b-440a-898f-ef9516126d27}\u0022 type=\u0022document\u0022\u003Etimeline\u003C/a\u003E\u003C/li\u003E\n\u003Cli\u003E\u003Ca href=\u0022/{localLink:571f9cd8-af6b-4104-96fb-d871cbe58ce3}\u0022 type=\u0022document\u0022\u003EYouTube video\u003C/a\u003E\u003C/li\u003E\n\u003C/ul\u003E"
          }
        }
