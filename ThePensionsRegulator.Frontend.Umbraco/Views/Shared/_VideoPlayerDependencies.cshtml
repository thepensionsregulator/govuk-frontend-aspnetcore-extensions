@using Microsoft.CSharp.RuntimeBinder
@{
    // If the consent cookie has not been set, we do not want to add the dependencies
    if(!Context.Request.Cookies.TryGetValue("TPR_Cookie_CONSENT", out string? cookieValue) || cookieValue == "Reject")
    {
        return;
    }
}

