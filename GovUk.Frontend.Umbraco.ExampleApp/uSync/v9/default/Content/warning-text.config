    {
      "contentTypeKey": "83cb35fb-51da-45cd-913f-1b8bdfd6a1d9",
      "iconFallbackText": "",
      "text": {
        "markup": "<p>Use the <a href=\"https://design-system.service.gov.uk/components/warning-text/\">warning text</a> component when you need to warn users about something important, such as legal consequences of an action, or lack of action, that they might take.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/781251e90fab43739001b6add4475645"
    },
    {
      "caption": "Example application in Umbraco",
      "contentTypeKey": "bfeed15c-3ebb-46d4-b805-07d0f9b083c7",
      "udi": "umb://element/aa905fd382684d2c8d969db1dd7b4535"
    },
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
