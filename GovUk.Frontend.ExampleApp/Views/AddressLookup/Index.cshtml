@{
    ViewData["Title"] = "Address lookup";
}
@model AddressLookupViewModel

<span class="govuk-caption-xl">Example application</span>
<div class="govuk-grid-row govuk-grid-row--tpr-divider">
    <div class="govuk-grid-column govuk-grid-column-full">
        <h1 class="govuk-heading-l">@ViewData["Title"]</h1>
    </div>
</div>

<form method="post">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column govuk-grid-column-full">
            <tpr-address-lookup 
                legend="Your address custom" 
                hint="Enter the address you want to use"
                search-button-text="Submit address"
                address-line-1-label="Custom address line 1"
                address-line-2-label="Custom address line 2"
                address-line-3-label="Custom address line 3"
                post-town-label="Custom post town"
                post-county-label="Custom post county"
                postcode-label="Custom postcode"
                country-label="Custom country"
                for="@Model.ShippingAddress" />
        </div>
    </div>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column govuk-grid-column-full">
            <button type="submit" class="govuk-button">Submit</button>
        </div>
    </div>
</form>

@section scripts {
    <script src="~/js/address-lookup-example.js" type="module"></script>
}