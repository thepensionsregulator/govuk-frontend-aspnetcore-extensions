              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis component relies on JavaScript to display content.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "40bb2a3e-3d75-4ec1-9134-e0c46c6f04a0",
      "key": "3d987655-97fb-4f86-bc03-1b748a7b772c",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cdiv\u003E\u0022SearchResultsApiEndpoints\u0022: {\u003C/div\u003E\n\u003Cdiv\u003E\u003Cspan\u003E\u0026nbsp; \u0026nbsp; \u0022ContentByIdUrl\u0022: \u0022/SearchResultsData/\u0022,\u003C/span\u003E\u003C/div\u003E\n\u003Cdiv\u003E\u003Cspan\u003E\u0026nbsp; \u0026nbsp; \u0022SearchContentUrl\u0022: \u0022/SearchResultsData/searchResults.json\u0022,\u003C/span\u003E\u003C/div\u003E\n\u003Cdiv\u003E\u003Cspan\u003E\u0026nbsp; \u0026nbsp; \u0022PopularContentUrl\u0022: \u0022/SearchResultsData/popularContentExample.json\u0022\u003C/span\u003E\u003C/div\u003E\n\u003Cdiv\u003E}\u003C/div\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "5be88fe5-3427-49e7-95c8-5a211fa350db",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe JavaScript file \u003Cstrong\u003E\u0027tpr-search-results.min.js\u0027\u003C/strong\u003E is provided as part of the \u003Cstrong\u003E\u0027ThePensionsRegulator.Frontend\u0027\u003C/strong\u003E nuget package. This will need to be included in any view that uses this component outside of Umbraco.\u003C/p\u003E"
          }
        }
      ]
    },
