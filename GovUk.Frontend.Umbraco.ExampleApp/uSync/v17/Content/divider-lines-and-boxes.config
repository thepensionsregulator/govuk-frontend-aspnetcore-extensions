    <Template Key="2cc0cf69-0a1d-47f0-93d2-d98606693e72">DividerLines</Template>
  </Info>
  <Properties>
    <blocks>
      <Value><![CDATA[{
  "contentData": [
    {
      "contentTypeKey": "394dc214-e2ad-4605-ab3f-2c6b83063ef6",
      "key": "bb9937a5-216c-4a58-a0c3-1ac46a981914",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "fef09d4a-5fcb-4fce-b235-6135df68a203",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThe Pensions Regulator (TPR) pages include dividing lines which can be applied to a \u003Cem\u003E.govuk-grid-row\u003C/em\u003E at any level by applying the \u003Cem\u003E.govuk-grid-row--tpr-divider\u003C/em\u003E.\u003C/p\u003E\n\u003Cp\u003EThey typically appear after the main heading and before the submit button of a form. Wherever possible we only applying spacing using padding and margin on the bottom, not the top of elements, therefore the \u003Cem\u003E.govuk-grid-row--tpr-divider\u003C/em\u003E class should be applied to the row \u003Cstrong\u003Ebefore\u003C/strong\u003E the point where the divider should appear.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "72ca2291-9065-4357-a88e-8dbd6663d681",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EDividers should always span the full width, even when the content they follow does not.\u003C/p\u003E\n\u003Cp\u003EThis is a divider after a \u0027Text\u0027 component.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "fe2dd0de-55a9-4249-be03-6896aa719974",
      "key": "db2adb60-5123-4e02-a0f2-de1f6c5c59cb",
      "values": [
        {
          "alias": "hint",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Text input without a divider"
        }
      ]
    },
    {
      "contentTypeKey": "fe2dd0de-55a9-4249-be03-6896aa719974",
      "key": "e9db258f-23cd-479e-93dc-e1946fc7d168",
      "values": [
        {
          "alias": "hint",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "label",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Text input with a divider"
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "41c33483-7468-4b27-b333-ae0a9ca1a69d",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EYou can also highlight content in a box by applying \u003Cem\u003E.tpr-box\u003C/em\u003E.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "e0876897-88f4-4dcf-ae0a-ec5a37e3a185",
      "key": "07e37dad-713f-4058-9720-84c21693993b",
      "values": [
        {
          "alias": "text",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThis box has a divider applied and the column is set to full width to show the two styles working together.\u003C/p\u003E"
          }
        }
      ]
    },
    {
      "contentTypeKey": "b84a633b-1ee7-4a5c-80bd-4267420ed133",
      "key": "ca951f08-7666-4cf0-9078-a04f7a2ebb84",
      "values": [
        {
          "alias": "fieldsetBlocks",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "hint",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "Layout": {}
            },
            "markup": "\u003Cp\u003EThere is a special case where radio buttons or checkboxes have the legend set as the main page heading.\u003C/p\u003E\n\u003Cp\u003ETypically two dividers should appear:\u003C/p\u003E\n\u003Cul\u003E\n\u003Cli\u003Eone below the heading, applied using\u00A0\u003Cem\u003E.govuk-grid-row--tpr-divider-for-fieldset\u003C/em\u003E\u003C/li\u003E\n\u003Cli\u003Eone below the radio buttons, applied using \u003Cem\u003E.govuk-grid-row--tpr-divider\u003C/em\u003E as normal\u003C/li\u003E\n\u003C/ul\u003E"
          }
        },
        {
          "alias": "legend",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Radios where the legend is the heading"
        },
