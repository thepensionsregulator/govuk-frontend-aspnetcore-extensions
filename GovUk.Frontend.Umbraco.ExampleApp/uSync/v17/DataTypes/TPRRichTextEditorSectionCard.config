<?xml version="1.0" encoding="utf-8"?>
<DataType Key="cf0427f6-51a2-420d-89b1-a4eb95f556ac" Alias="TPR Rich text editor (Section card)" Level="2">
  <Info>
    <Name>TPR Rich text editor (Section card)</Name>
    <EditorAlias>Umbraco.RichText</EditorAlias>
    <EditorUIAlias>Umb.PropertyEditorUi.TinyMCE</EditorUIAlias>
    <Folder>TPR</Folder>
  </Info>
  <Config><![CDATA[{
  "hideLabel": false,
  "ignoreUserStartNodes": false,
  "maxImageSize": 500,
  "mode": "Classic",
  "overlaySize": "small",
  "stylesheets": [
    "/govuk-umbraco-backoffice.css",
    "/site.css"
  ],
  "toolbar": [
    "removeformat",
    "bold",
    "italic",
    "bullist",
    "numlist",
    "link",
    "subscript",
    "superscript",
    "charmap"
  ],
  "useLiveEditing": false
}]]></Config>
</DataType>