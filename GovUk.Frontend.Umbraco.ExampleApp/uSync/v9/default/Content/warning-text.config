      "udi": "umb://element/cd71d869a5ea4a14b1c6c5789fa8ea20"
    },
    {
      "contentTypeKey": "83cb35fb-51da-45cd-913f-1b8bdfd6a1d9",
      "iconFallbackText": "",
      "text": {
        "markup": "<p class=\"custom-class\">When there is a single paragraph with no class applied, the surrounding <strong>p </strong>element should be removed. This warning text component has just one paragraph but a custom class is applied, so the <strong>p</strong> element should be kept.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "udi": "umb://element/f1e5ecbe3f554a9d85cc590ddcd9fdc9"
    },
    {
      "contentTypeKey": "83cb35fb-51da-45cd-913f-1b8bdfd6a1d9",
      "iconFallbackText": "",
      "text": {
        "markup": "<p class=\"govuk-body\">Warning text components can (although rarely should) contain multiple paragraphs.</p>\n<p class=\"custom-class govuk-body\">Custom classes can be applied when there are multiple paragraphs.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
